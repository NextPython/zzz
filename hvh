function Tab.new(win, name)
    local t = setmetatable({}, Tab)
    t.win, t.name, t.sections, t.objects = win, name, {}, {}
    t.z, t.scroll, t.contentY, t.total = 11, 0, win.y + 52, 0
    t.btn    = rect(t, T.panel, true, 0)
    t.txt    = label(t, 12, T.sub, name, false, FONT.UI)
    t.pill   = rect(t, accent(), true, 0)
    sp(t.btn, "Corner", 4)
    table.insert(win.tabs, t)
    if not win.tab then win.tab = t end
    t:show(false)
    win:apply()
    return t
end
function Tab:show(v)
    for _, o in ipairs(self.objects) do if o then sp(o, "Visible", v) end end
    for _, s in ipairs(self.sections) do s:show(v) end
    self.on = v
end
function Tab:layout()
    local y = 8
    for _, s in ipairs(self.sections) do
        s.baseY = self.contentY + y - self.scroll
        s:layout()
        y = y + s.h + 10
    end
    self.total = y
    local win = self.win
    for i, t in ipairs(win.tabs) do
        local by = win.y + 54 + (i - 1) * 30
        t.btn.Position = Vector2.new(win.x + 8, by)
        t.btn.Size = Vector2.new(134, 26)
        t.txt.Position = Vector2.new(win.x + 18, by + 6)
        t.pill.Position = Vector2.new(win.x + 2, by + 5)
        t.pill.Size = Vector2.new(3, 16)
        local on = (t == win.tab)
        t.pill.Visible = on
        t.btn.Color = on and T.panel2 or T.panel
        t.txt.Color = on and T.text or T.sub
    end
end
function Tab:search(q)
    q = q:lower()
    for _, s in ipairs(self.sections) do s:search(q) end
    self:layout()
end

