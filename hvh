local Char, Hum, HRP

local function refresh()
    Camera = Workspace and Workspace.CurrentCamera
    LP = Players and Players.LocalPlayer
    Char = LP and LP.Character
    Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    HRP = Char and Char:FindFirstChild("HumanoidRootPart")
end

local function alive(p)
    local c = p and p.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health > 0
end

local function sameTeam(p)
    local a = LP and LP.Team
    return a ~= nil and p.Team == a
end

local function toolName(p)
    local c = p and p.Character
    local t = c and c:FindFirstChildOfClass("Tool")
    return t and t.Name or ""
end

local function w2s(pos)
    local ok, v, on = pcall(WorldToScreen, pos)
    if ok and v then return v, on end
    return nil, false
end

local function viewport()
    local ok, v = pcall(function() return Camera.ViewportSize end)
    if ok and v then return v end
    return Vector2.new(1920, 1080)
end

local function center()
    local v = viewport()
    return Vector2.new(v.X / 2, v.Y / 2)
end

local function viewYaw()
    local ok, v = pcall(function() return Camera.CFrame.LookVector end)
    if ok and v then return math.deg(math.atan2(-v.X, -v.Z)) end
    if HRP then
        local ok2, v2 = pcall(function() return HRP.CFrame.LookVector end)
        if ok2 and v2 then return math.deg(math.atan2(-v2.X, -v2.Z)) end
    end
    return 0
end

local function camPos()
    local ok, p = pcall(function() return Camera.Position end)
    if ok then return p end
end

local function visiblePart(part)
    if not part then return false end
    local cam = camPos()
    if not cam then return true end
    local dir = part.Position - cam
    local ok, hit = pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { Char, Camera }
        return Workspace:Raycast(cam, dir, params)
    end)
    if ok and hit ~= nil then return hit.Instance:IsDescendantOf(part.Parent) end
    return true
end

local Hist = {}
local function pushHist()
    local t = now()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChild("HumanoidRootPart")
            if h then
                local l = Hist[p]
                if not l then l = {}; Hist[p] = l end
                table.insert(l, { pos = h.Position, t = t })
                while #l > 0 and t - l[1].t > 0.4 do table.remove(l, 1) end
            end
        end
    end
end

--=====================================================================
-- [7] TARGETING
--=====================================================================
local HITBOXES = { "Head", "UpperTorso", "HumanoidRootPart", "LowerTorso", "Torso" }
local Target

local function hitboxOf(p)
    local c = p.Character
    local mode = get("aim.hitbox")
    if mode == "Nearest" then
        local m, best, bd = getMouse(), nil, nil
        for _, n in ipairs(HITBOXES) do
            local part = c:FindFirstChild(n)
            if part then
                local sp2 = w2s(part.Position)
                if sp2 then
                    local d = (sp2 - Vector2.new(m.X, m.Y)).Magnitude
                    if not bd or d < bd then bd, best = d, part end
                end
            end
        end
        return best
    end
    return c:FindFirstChild(mode) or c:FindFirstChild("HumanoidRootPart")
end

local function validTarget(p)
    if p == LP or not p.Character then return false end
    if get("aim.teamcheck") and sameTeam(p) then return false end
    if get("aim.alive") and not alive(p) then return false end
    if get("aim.wallcheck") and not visiblePart(p.Character:FindFirstChild("HumanoidRootPart")) then return false end
    if get("aim.distcheck") then
        local c = camPos()
        local hb = p.Character:FindFirstChild("HumanoidRootPart")
        if c and hb and (c - hb.Position).Magnitude > get("aim.maxdist") then return false end
    end
    return true
end

local function acquire()
    local m = getMouse()
    local mp = Vector2.new(m.X, m.Y)
    local fov = get("aim.fov")
    local best, bd = nil, fov
    local mode = get("aim.target")
    for _, p in ipairs(Players:GetPlayers()) do
        if validTarget(p) then
            local hb = hitboxOf(p)
            if hb then
                local sp2 = w2s(hb.Position)
                if sp2 then
                    local d = (sp2 - mp).Magnitude
                    if d < bd then bd, best = d, p end
                end
            end
        end
    end
    if best and mode == "Lowest HP" then
        local low
        for _, p in ipairs(Players:GetPlayers()) do
            if validTarget(p) then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 and (not low or h.Health < low.Health) then
                    local hb = hitboxOf(p)
                    local sp2 = hb and w2s(hb.Position)
                    if sp2 and (sp2 - mp).Magnitude < fov then low = h end
                end
            end
        end
        if low then return low.Parent end
    end
    return best
end

local function aimPoint(p)
    local hb = hitboxOf(p)
    if not hb then return nil end
    local pos = hb.Position
    local pred = get("aim.prediction")
    if pred > 0 then
        local v = hb.AssemblyLinearVelocity
        if v then pos = pos + v * (pred / 1000) end
    end
    if get("aim.multipoint") then
        local s = hb.Size * (get("aim.mp_scale") / 100)
        local seed = math.floor(now() * 14)
        pos = pos + Vector3.new(
            (((seed * 37) % 100) / 50 - 1) * s.X * 0.5,
            (((seed * 71) % 100) / 50 - 1) * s.Y * 0.5, 0)
    end
    if get("aim.backtrack") then
        local l = Hist[p]
        if l and #l > 2 then
            pos = l[math.max(1, #l - math.floor(get("aim.bt_amount")))].pos
        end
    end
    return pos
end

local function hitchance(p)
    local hb = hitboxOf(p)
    if not hb then return 0 end
    local hits = 0
    for _ = 1, 8 do
        local sp2, on = w2s(hb.Position + Vector3.new(
            (math.random() - 0.5) * hb.Size.X,
            (math.random() - 0.5) * hb.Size.Y, 0))
        if sp2 and on then hits = hits + 1 end
    end
    return hits / 8 * 100
end

local function resolvedPoint(p)
    local mode = get("aim.resolver")
    if mode == "Off" then return nil end
    local hb = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    if not hb then return nil end
    local v = hb.AssemblyLinearVelocity
    if mode == "Velocity" or (mode == "Adaptive" and v and v.Magnitude > 6) then
        return hb.Position + v.Unit * (hb.Size.Z * 0.5)
    end
    return hb.Position
end

--=====================================================================
-- [8] FEATURES · AIM
--=====================================================================
local lastShot = 0

local function doAim(dt)
    if not get("aim.enabled") then Target = nil return end
    if not Char or not Hum or Hum.Health <= 0 then return end

    local vk = get("aim.key")
    if vk and vk ~= 0 and not vkDown(vk) then Target = nil return end

    local p = acquire()
    if not p then Target = nil return end
    Target = p

    local pos = resolvedPoint(p) or aimPoint(p)
    if not pos then return end
    local sp2 = w2s(pos)
    if not sp2 then return end

    if get("aim.hitchance_on") and hitchance(p) < get("aim.hitchance") then return end

    local m = getMouse()
    local dx, dy = sp2.X - m.X, sp2.Y - m.Y
    if math.abs(dx) < 1 and math.abs(dy) < 1 then
        -- ya apuntando
    elseif get("aim.silent") or get("aim.rage") then
        moveAbs(sp2.X, sp2.Y)
    else
        local f = clamp((12 - clamp(get("aim.smooth"), 1, 30)) / 10, 0.04, 1)
        moveRel(dx * f, dy * f)
    end

    if get("aim.auto_fire") and now() - lastShot > 1 / math.max(get("aim.fire_rate"), 1) then
        if not get("aim.hitchance_on") or hitchance(p) >= get("aim.hitchance") then
            pcall(mouse1press); after(0.02, function() pcall(mouse1release) end)
            lastShot = now()
        end
    end
end

local lastTrig = 0
local function doTrigger()
    if not get("trigger.enabled") then return end
    local p = Target or acquire()
    if not p then return end
    local hb = hitboxOf(p)
    if not hb then return end
    local sp2 = w2s(hb.Position)
    if not sp2 then return end
    local m = getMouse()
    if (sp2 - Vector2.new(m.X, m.Y)).Magnitude <= get("trigger.radius")
    and now() - lastTrig > get("trigger.delay") then
        pcall(mouse1press); after(0.02, function() pcall(mouse1release) end)
        lastTrig = now()
    end
end

--=====================================================================
-- [9] FEATURES · ANTI-AIM
--=====================================================================
local spinYaw = 0
local function doAA(dt)
    if not get("aa.enabled") or not HRP then return end
    local base = viewYaw()
    local yaw = base + get("aa.yaw_offset")

    if get("aa.spin") then
        spinYaw = spinYaw + get("aa.spin_speed") * 360 * dt
        yaw = spinYaw
    elseif get("aa.jitter") then
        yaw = base + (math.random() > 0.5 and get("aa.jitter_range") or -get("aa.jitter_range"))
    elseif get("aa.random") then
        if math.random() > 0.88 then spinYaw = base + (math.random() - 0.5) * 180 end
        yaw = spinYaw
    elseif get("aa.static") then
        yaw = get("aa.static_yaw")
    end

    if get("aa.inverter") then yaw = -yaw end

    if get("aa.lby") then
        local v = HRP.AssemblyLinearVelocity
        if v and math.abs(v.X) + math.abs(v.Z) < 1.5 then
            yaw = yaw + ((now() % 1 > 0.5) and 32 or -32)
        end
    end
    if get("aa.fake_flick") and math.random() > 0.94 then
        yaw = yaw + math.random(-90, 90)
    end

    local pitch = get("aa.pitch")
    if get("aa.fake_pitch") then
        pitch = (math.floor(now() * 7) % 2 == 0) and 89 or -89
    end

    local off = Vector3.new(0, 0, 0)
    if get("aa.desync") then off = Vector3.new(get("aa.desync_amt") / 100, 0, 0) end

    local ok = pcall(function()
        HRP.CFrame = CFrame.new(HRP.Position + off) * CFrame.Angles(math.rad(pitch), math.rad(yaw), 0)
    end)
    if not ok then
        pcall(function() HRP.Position = HRP.Position + off end)
    end
end

