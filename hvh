-- [10] FEATURES · MOVIMIENTO
--=====================================================================
local VK_SPACE, VK_A, VK_D, VK_CTRL = 0x20, 0x41, 0x44, 0x11
local grounded, lastJump, lastCrouch = true, 0, 0

local function doMove()
    if not Hum or not HRP then return end
    local v = HRP.AssemblyLinearVelocity
    grounded = v and math.abs(v.Y) < 2.5 or false

    if get("mv.bhop") and vkDown(VK_SPACE) and grounded and now() - lastJump > 0.12 then
        pcall(keypress, VK_SPACE); after(0.05, function() pcall(keyrelease, VK_SPACE) end)
        lastJump = now()
    end

    if get("mv.crouch_spam") and now() - lastCrouch > 0.06 then
        pcall(keypress, VK_CTRL); after(0.03, function() pcall(keyrelease, VK_CTRL) end)
        lastCrouch = now()
    end

    if get("mv.slowwalk") then
        pcall(function() Hum.WalkSpeed = get("mv.slow_speed") end)
    elseif get("mv.base_speed") > 0 then
        pcall(function() Hum.WalkSpeed = get("mv.base_speed") end)
    end

    if (get("mv.autostrafe") or get("mv.airstrafe")) and not grounded and v and v.Magnitude > 3 then
        local ok, look = pcall(function() return Camera.CFrame.LookVector end)
        if ok and look then
            local right = Vector3.new(-look.Z, 0, look.X)
            local dir = Vector3.new(v.X, 0, v.Z).Unit
            local key = (right:Dot(dir) > 0) and VK_D or VK_A
            pcall(keypress, key); after(0.04, function() pcall(keyrelease, key) end)
        end
    end

    if get("mv.faststop") and grounded and v and v.Magnitude > 8 then
        local dir = Vector3.new(v.X, 0, v.Z).Unit
        local ok, look = pcall(function() return Camera.CFrame.LookVector end)
        if ok and look then
            local key = (Vector3.new(-look.Z, 0, look.X):Dot(dir) > 0) and VK_A or VK_D
            pcall(keypress, key); after(0.05, function() pcall(keyrelease, key) end)
        end
    end
end

local function doDuck()
    if not get("mv.fakeduck") or not Hum then return end
    pcall(function() Hum.HipHeight = ((math.floor(now() * 9) % 2 == 0) and 1.3 or 0.5) end)
end

