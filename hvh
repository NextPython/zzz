local function forEachElement(fn)
    for _, t in ipairs(Lib.tabs) do
        for _, s in ipairs(t.sections) do
            for _, e in ipairs(s.items) do fn(e) end
        end
    end
end

local function routeClick(mx, my)
    -- ventana
    if mx >= Lib.x + Lib.w - 26 and mx <= Lib.x + Lib.w and my >= Lib.y + 6 and my <= Lib.y + 28 then
        Lib.open = false; Lib:show(false); Lib:setInput(true); return
    end
    if mx >= Lib.x + Lib.w - 50 and mx <= Lib.x + Lib.w - 28 and my >= Lib.y + 6 and my <= Lib.y + 28 then
        Lib.min = not Lib.min; Lib:apply(); return
    end
    if my >= Lib.y and my <= Lib.y + 44 and mx >= Lib.x and mx <= Lib.x + Lib.w then
        Lib.drag = true
        Lib.dragOff = Vector2.new(mx - Lib.x, my - Lib.y)
        return
    end
    if Lib.min then return end

    -- search
    local sp2 = Lib.sBox.Position
    if mx >= sp2.X and mx <= sp2.X + Lib.sBox.Size.X and my >= sp2.Y and my <= sp2.Y + Lib.sBox.Size.Y then
        Lib.searchFocus = not Lib.searchFocus
        if not Lib.searchFocus then
            Lib.search = ""; Lib.sTxt.Text = "buscar..."
            for _, t in ipairs(Lib.tabs) do t:search("") end
        end
        return
    end

    -- tabs
    for _, t in ipairs(Lib.tabs) do
        local b = t.btn.Position
        if mx >= b.X and mx <= b.X + t.btn.Size.X and my >= b.Y and my <= b.Y + t.btn.Size.Y then
            Lib.tab = t
            for _, o in ipairs(Lib.tabs) do o:show(o == t) end
            Lib:apply()
            return
        end
    end

    -- elementos
    if Lib.tab then
        for _, s in ipairs(Lib.tab.sections) do
            for _, e in ipairs(s.items) do
                if e.hit then
                    local r = e.hit(mx, my)
                    if r then return end
                end
            end
        end
    end
end

local function routeDrag(mx)
    forEachElement(function(e)
        if e.drag and e.update then e.update(mx) end
    end)
end

local function clearDrag()
    forEachElement(function(e) e.drag = false end)
    Lib.drag = false
end

local function scrollBy(d)
    if not Lib.open or Lib.min or not Lib.tab then return end
    local maxS = math.max(0, (Lib.tab.total or 0) - (Lib.h - 60))
    Lib.tab.scroll = clamp(Lib.tab.scroll - d, 0, maxS)
    Lib.tab:layout()
    Lib:scrollbar()
end

local function captureKey(vk)
    local captured = false
    forEachElement(function(e)
        if e.capture and e.capture(vk) then captured = true end
    end)
    return captured
end

local function typeChar(vk)
    if not Lib.searchFocus then return end
    local ch = VK[vk]
    if vk == 0x08 then
        Lib.search = Lib.search:sub(1, -2)
    elseif ch and #ch == 1 then
        if #Lib.search < 18 then Lib.search = Lib.search .. ch:lower() end
    else return end
    Lib.sTxt.Text = Lib.search == "" and "buscar..." or Lib.search
    for _, t in ipairs(Lib.tabs) do t:search(Lib.search) end
end

--=====================================================================
-- [17] LOOP
--=====================================================================
local MENU_VK = 0x2D
local lastMenu, lastDown = false, false
local lastArrow = 0

local function step(dt)
    if not _G.MHVH.running then return end
    refresh()
    getMouse()
    runTimers()

    -- toggle menú
    local mdown = vkDown(MENU_VK)
    if mdown and not lastMenu then
        Lib.open = not Lib.open
        Lib:show(Lib.open)
        Lib:setInput(not Lib.open)
        if Lib.open then Lib.searchFocus = false end
    end
    lastMenu = mdown

    -- mouse
    local down = false
    local okd, d = pcall(ismouse1pressed)
    if okd then down = d == true end
    local mx, my = Mouse.X, Mouse.Y

    if Lib.open and not Lib.min then
        if down and not lastDown then routeClick(mx, my) end
        if down then routeDrag(mx) end
        if not down and lastDown then clearDrag() end
        if vkDown(0x28) and now() - lastArrow > 0.05 then scrollBy(-26); lastArrow = now() end
        if vkDown(0x26) and now() - lastArrow > 0.05 then scrollBy(26); lastArrow = now() end
    elseif Lib.drag and down then
        Lib.x = mx - Lib.dragOff.X
        Lib.y = my - Lib.dragOff.Y
        Lib:apply()
    end
    if not down then Lib.drag = false end
    lastDown = down

    -- gameplay
    pcall(doAim, dt)
    pcall(doTrigger)
    pcall(doAA, dt)
    pcall(doMove)
    pcall(doDuck)
    pcall(noRecoil)
    pcall(overlay)
    if get("esp.enabled") then pcall(drawESP) else
        for _, e in pairs(ESP) do hide(e) end
    end
    pcall(healthWatch)
    pcall(pushHist)
    pcall(drawNotifs, dt)

    if Camera then
        if get("misc.fov_change") then pcall(function() Camera.FieldOfView = get("misc.fov") end) end
        if get("misc.tp") and HRP then
            pcall(function()
                local look = Camera.CFrame.LookVector
                Camera.lookAt(HRP.Position - look * get("misc.tp_dist"), HRP.Position)
            end)
        end
    end
end

