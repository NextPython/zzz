local function alive(p)
    local c = p and p.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function teams(p)
    local a = LP and LP.Team
    return a and p.Team == a
end

local function toolName(p)
    local c = p and p.Character
    local t = c and c:FindFirstChildOfClass("Tool")
    return t and t.Name or ""
end

local function w2s(pos)
    if not Camera then return nil, false end
    local ok, sp, on = pcall(function() return Camera:WorldToScreenPoint(pos) end)
    if ok and sp then return Vector2.new(sp.X, sp.Y), on end
    local ok2, rel = pcall(function() return Camera.CFrame:PointToObjectSpace(pos) end)
    if not ok2 then return nil, false end
    local z = -rel.Z
    if z <= 0.05 then return nil, false end
    local ok3, vp = pcall(function() return Camera.ViewportSize end)
    if not ok3 then return nil, false end
    local fov = math.rad(Camera.FieldOfView)
    local f = (vp.Y / 2) / math.tan(fov / 2)
    local sx = vp.X / 2 + (rel.X * f) / z
    local sy = vp.Y / 2 - (rel.Y * f) / z
    return Vector2.new(sx, sy), (sx >= 0 and sx <= vp.X and sy >= 0 and sy <= vp.Y)
end

local function center()
    local ok, vp = pcall(function() return Camera.ViewportSize end)
    if ok and vp then return Vector2.new(vp.X / 2, vp.Y / 2) end
    return Vector2.new(1280, 720)
end

local function visible(part)
    if not part then return false end
    local p = part.Position
    local dir = (p - Camera.CFrame.Position)
    local ray = Ray.new(Camera.CFrame.Position, dir.Unit * (dir.Magnitude + 0.5))
    local ok, hit = pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { Char, Camera }
        return Workspace:Raycast(Camera.CFrame.Position, dir, params)
    end)
    if ok then
        if not hit then return true end
        return (hit.Instance:IsDescendantOf(part.Parent))
    end
    local ok2, hit2 = pcall(function()
        return Workspace:FindPartOnRayWithIgnoreList(ray, { Char, Camera })
    end)
    return ok2 and (hit2 == nil or hit2:IsDescendantOf(part.Parent))
end

-- Historial (backtrack / resolver)
local Hist = {}
local function pushHist()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) and p.Character then
            local h = p.Character:FindFirstChild("HumanoidRootPart")
            if h then
                local list = Hist[p] or {}
                table.insert(list, { pos = h.Position, t = os.clock() })
                while #list > 0 and os.clock() - list[1].t > 0.5 do table.remove(list, 1) end
                Hist[p] = list
            end
        end
    end
end

