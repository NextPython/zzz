    sp(e.preview, "Corner", 3)
    sp(e.brd, "Corner", 3)
    function e:place(x, y)
        self.txtLabel.Position = Vector2.new(x, y + 5)
        self.preview.Position  = Vector2.new(x + self.win_w - 40, y + 4)
        self.preview.Size      = Vector2.new(34, 16)
        self.brd.Position      = Vector2.new(x + self.win_w - 40, y + 4)
        self.brd.Size          = Vector2.new(34, 16)
        self.ox, self.oy       = x + self.win_w - 130, y + 24
    end
    function e:build()
        for _, o in ipairs(self.pops) do kill(o) end
        self.pops = {}
        for i = 0, 25 do
            local c = Color3.fromHSV(i / 25, 0.78, 1)
            local p = rect(e, c, true, 0)
            p.Position = Vector2.new(self.ox + i * 5, self.oy)
            p.Size = Vector2.new(5, 12); p.ZIndex = 40; p.Visible = self.open
            table.insert(self.pops, p)
        end
    end
    e.hit = function(mx, my)
        if not e.match then return false end
        if self.open then
            if my >= self.oy and my <= self.oy + 12 and mx >= self.ox and mx <= self.ox + 130 then
                local c = Color3.fromHSV(clamp((mx - self.ox) / 130, 0, 1), 0.78, 1)
                set(key, { math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255) })
                self.preview.Color = c
                if cb then pcall(cb, get(key)) end
                return true
            end
            self.open = false; e:build(); return true
        end
        local p = e.preview.Position
        if mx >= p.X and mx <= p.X + 34 and my >= p.Y and my <= p.Y + 16 then
            self.open = true; e:build(); return true
        end
        return false
    end
    e:place(0, 0)
    return e
end

