local UI = {}
UI.__index = UI

function UI.new(title, sub)
    local self = setmetatable({}, UI)
    self.objects, self.z = {}, 10
    self.tabs, self.tab = {}, nil
    self.x, self.y, self.w, self.h = 160, 130, 720, 480
    self.open, self.min = true, false
    self.drag, self.dragOff = false, Vector2.new()
    self.search, self.searchFocus = "", false

    self.frame   = rect(self, T.bg, true, 0.04)
    self.outline = rect(self, T.stroke, false, 0, 1)
    self.bar     = rect(self, T.panel, true, 0)
    self.accent  = rect(self, accent(), true, 0)
    self.side    = rect(self, T.panel, true, 0)
    self.logo    = label(self, 16, T.text, title, false, FONT.Bold)
    self.logo2   = label(self, 10, T.sub, sub, false, FONT.UI)
    self.close   = label(self, 16, T.sub, "x", true, FONT.Bold)
    self.mini    = label(self, 15, T.sub, "-", true, FONT.Bold)
    self.sBox    = rect(self, T.panel2, true, 0)
    self.sTxt    = label(self, 12, T.sub, "buscar...", false, FONT.UI)
    self.content = rect(self, T.bg, true, 0)
    self.scroll  = rect(self, T.stroke, true, 0)
    self.knob    = rect(self, accent(0.2), true, 0)

    sp(self.frame, "Corner", 6)
    sp(self.outline, "Corner", 6)
    sp(self.sBox, "Corner", 4)
    sp(self.knob, "Corner", 2)

    self:apply()
    return self
end

function UI:apply()
    local w, h = self.w, (self.min and 44 or self.h)
    local x, y = self.x, self.y
    self.frame.Position  = Vector2.new(x, y); self.frame.Size = Vector2.new(w, h)
    self.outline.Position= Vector2.new(x, y); self.outline.Size = Vector2.new(w, h)
    self.bar.Position    = Vector2.new(x, y); self.bar.Size = Vector2.new(w, 44)
    self.accent.Position = Vector2.new(x, y); self.accent.Size = Vector2.new(w, 2)
    self.side.Position   = Vector2.new(x, y + 44); self.side.Size = Vector2.new(150, h - 44)
    self.logo.Position   = Vector2.new(x + 14, y + 9)
    self.logo2.Position  = Vector2.new(x + 14, y + 27)
    self.close.Position  = Vector2.new(x + w - 18, y + 12)
    self.mini.Position   = Vector2.new(x + w - 42, y + 12)
    self.sBox.Position   = Vector2.new(x + 160, y + 9)
    self.sBox.Size       = Vector2.new(w - 216, 26)
    self.sTxt.Position   = Vector2.new(x + 168, y + 14)
    self.content.Position= Vector2.new(x + 150, y + 44)
    self.content.Size    = Vector2.new(w - 150, h - 44)
    for _, t in ipairs(self.tabs) do
        t.contentY = y + 52
        t:layout()
    end
    self:scrollbar()
end

function UI:scrollbar()
    if not self.tab then return end
    local visible = (self.tab.total or 0) > (self.h - 60)
    self.scroll.Visible = visible and not self.min
    self.knob.Visible = visible and not self.min
    if not visible then return end
    local trackH = self.h - 70
    local ratio = (self.h - 60) / math.max(self.tab.total, 1)
    local kh = math.max(24, trackH * ratio)
    local maxScroll = math.max(1, self.tab.total - (self.h - 60))
    local p = clamp(self.tab.scroll / maxScroll, 0, 1)
    self.scroll.Position = Vector2.new(self.x + self.w - 7, self.y + 50)
    self.scroll.Size = Vector2.new(3, trackH)
    self.knob.Position = Vector2.new(self.x + self.w - 7, self.y + 50 + (trackH - kh) * p)
    self.knob.Size = Vector2.new(3, kh)
end

function UI:show(v)
    for _, o in ipairs(self.objects) do if o then sp(o, "Visible", v) end end
    for _, t in ipairs(self.tabs) do t:show(v and t == self.tab) end
    if v then self:scrollbar() end
end

function UI:setInput(b)
    pcall(setrobloxinput, b)
end

