local fired, lastShot, lastClick = 0, 0, 0

local function doAim(dt)
    if not get("aim.enabled") then Target = nil return end
    if not LP or not Char or not Hum or Hum.Health <= 0 then return end

    local key = get("aim.key")
    local held = true
    if key ~= "Always" and UIS then held = UIS:IsKeyDown(Enum.KeyCode[key] or Enum.KeyCode.E) end
    if not held then Target = nil return end

    local p = get("aim.silent") and acquire() or acquire()
    if not p then Target = nil return end
    Target = p

    local pos = aimPoint(p)
    if not pos then return end
    local sp = w2s(pos)
    if not sp then return end

    local m = getMouse()
    local dx, dy = sp.X - m.X, sp.Y - m.Y

    if get("aim.hitchance_enabled") and hitchance(p) < get("aim.hitchance") then return end

    if get("aim.silent") or get("aim.rage") then
        moveMouse(dx, dy)
    else
        local smooth = clamp(get("aim.smooth"), 1, 30)
        local f = clamp((12 - smooth) / 10, 0.05, 1)
        moveMouse(dx * f, dy * f)
    end

    if get("aim.auto_fire") and os.clock() - lastShot > (1 / math.max(get("aim.fire_rate"), 1)) then
        if not get("aim.hitchance_enabled") or hitchance(p) >= get("aim.hitchance") then
            press(); task.delay(0.02, release)
            lastShot = os.clock()
        end
    end
end

local function doTrigger()
    if not get("trigger.enabled") or not Target then return end
    local hb = getHitbox(Target)
    if not hb then return end
    local sp = w2s(hb.Position)
    if not sp then return end
    local m = getMouse()
    if (sp - Vector2.new(m.X, m.Y)).Magnitude <= get("trigger.radius") then
        if os.clock() - lastClick > get("trigger.delay") then
            press(); task.delay(0.02, release)
            lastClick = os.clock()
        end
    end
end

