    sp(s.bg, "Corner", 5)
    sp(s.stroke, "Corner", 5)
    table.insert(tab.sections, s)
    tab:layout()
    return s
end
function Section:show(v)
    for _, o in ipairs(self.objects) do if o then sp(o, "Visible", v) end end
    for _, e in ipairs(self.items) do e:show(v and e.match) end
    self.on = v
end
function Section:layout()
    local w = self.tab.win.w - 190
    local y = self.desc and 42 or 30
    for _, e in ipairs(self.items) do
        e.win_w = w
        if e.match then
            e:place(self.x + self.pad, self.baseY + y)
            y = y + e.h + 6
        end
    end
    self.h = y + self.pad
    self.bg.Position     = Vector2.new(self.x, self.baseY)
    self.bg.Size         = Vector2.new(w + 24, self.h)
    self.stroke.Position = Vector2.new(self.x, self.baseY)
    self.stroke.Size     = Vector2.new(w + 24, self.h)
    self.title.Position  = Vector2.new(self.x + self.pad, self.baseY + 10)
    if self.desc then self.desc.Position = Vector2.new(self.x + self.pad, self.baseY + 25) end
end
function Section:search(q)
    for _, e in ipairs(self.items) do
        e.match = (q == "") or (e.txtLabel and e.txtLabel.Text:lower():find(q, 1, true) ~= nil)
    end
end

