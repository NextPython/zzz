local Notifs = {}
function Notify(title, body, color)
    local n = { life = 3.5, objects = {} }
    n.bg  = rect(n, T.panel2, true, 0.05)
    n.brd = rect(n, color or accent(), false, 0, 1)
    n.acc = rect(n, color or accent(), true, 0)
    n.t1  = label(n, 12, T.text, title, false, FONT.Bold)
    n.t2  = label(n, 11, T.sub, body, false, FONT.UI)
    sp(n.bg, "Corner", 4)
    sp(n.brd, "Corner", 4)
    table.insert(Notifs, n)
end
local function drawNotifs(dt)
    local y = 62
    for i = #Notifs, 1, -1 do
        local n = Notifs[i]
        n.life = n.life - dt
        if n.life <= 0 then
            for _, o in ipairs(n.objects) do kill(o) end
            table.remove(Notifs, i)
        else
            local x = 20
            n.bg.Position = Vector2.new(x, y); n.bg.Size = Vector2.new(212, 42)
            n.brd.Position = Vector2.new(x, y); n.brd.Size = Vector2.new(212, 42)
            n.acc.Position = Vector2.new(x, y); n.acc.Size = Vector2.new(2, 42)
            n.t1.Position = Vector2.new(x + 10, y + 7)
            n.t2.Position = Vector2.new(x + 10, y + 23)
            y = y + 50
        end
    end
end

