function Section:Toggle(label, key, def, cb)
    reg(key, def)
    local e = base(self, 24, label)
    e.box   = rect(e, T.panel2, true, 0)
    e.stroke= rect(e, T.stroke, false, 0, 1)
    e.dot   = rect(e, accentColor(), true, 0)
    function e:place(x, y)
        self.label.Position = Vector2.new(x, y + 5)
        self.box.Position   = Vector2.new(x + self.win_w - 46, y + 4)
        self.box.Size       = Vector2.new(34, 16)
        self.stroke.Position= Vector2.new(x + self.win_w - 46, y + 4)
        self.stroke.Size    = Vector2.new(34, 16)
        local on = get(key)
        self.dot.Position = Vector2.new(on and (x + self.win_w - 30) or (x + self.win_w - 44), y + 6)
        self.dot.Size     = Vector2.new(12, 12)
        self.dot.Color    = on and accentColor() or T.sub
        self.label.Color  = on and T.text or T.sub
    end
    e.hit = function(x, y)
        if not e.match then return false end
        local p = e.box.Position
        if x >= p.X - 6 and x <= p.X + 44 and y >= p.Y - 4 and y <= p.Y + 24 then
            set(key, not get(key)); e:place(e.label.Position.X, e.label.Position.Y - 5)
            if cb then cb(get(key)) end
            return true
        end
        return false
    end
    e:place(0, 0)
    return e
end

function Section:Slider(label, key, min, max, def, dec, suffix, cb)
    reg(key, def)
    local e = base(self, 38, label)
    e.val   = text(e, 12, accentColor(), tostring(def))
    e.track = rect(e, T.panel2, true, 0)
    e.fill  = rect(e, accentColor(), true, 0)
    e.knob  = rect(e, T.text, true, 0)
    e.min, e.max, e.dec, e.suffix, e.cb = min, max, dec or 0, suffix or "", cb
    e.drag = false
    function e:draw()
        local v = get(key)
        local a = (v - self.min) / (self.max - self.min)
        self.val.Text = string.format("%." .. self.dec .. "f%s", v, self.suffix)
        self.fill.Size = Vector2.new((self.track.Size.X) * a, 4)
        self.knob.Position = Vector2.new(self.track.Position.X + self.track.Size.X * a - 3, self.track.Position.Y - 3)
    end
    function e:place(x, y)
        self.label.Position = Vector2.new(x, y + 2)
        self.val.Position   = Vector2.new(x + self.win_w - 46, y + 2)
        self.track.Position = Vector2.new(x, y + 22)
        self.track.Size     = Vector2.new(self.win_w - 46, 4)
        self.fill.Position  = Vector2.new(x, y + 22)
        self.knob.Size      = Vector2.new(6, 10)
        self:draw()
    end
    e.hit = function(x, y)
        if not e.match then return false end
        local p = e.track.Position
        if x >= p.X - 4 and x <= p.X + e.track.Size.X + 4 and y >= p.Y - 8 and y <= p.Y + 14 then
            e.drag = true; return "slider"
        end
        return false
    end
    e.update = function(mx)
        if not e.drag then return end
        local p = e.track.Position
        local a = clamp((mx - p.X) / e.track.Size.X, 0, 1)
        local v = self.min + (self.max - self.min) * a
        local m = 10 ^ e.dec
        set(key, math.floor(v * m + 0.5) / m)
        e:draw(); if e.cb then e.cb(get(key)) end
    end
    e:place(0, 0)
    return e
end

function Section:Dropdown(label, key, options, def, cb)
    reg(key, def)
    local e = base(self, 24, label)
    e.opts, e.open = options, false
    e.box    = rect(e, T.panel2, true, 0)
    e.stroke = rect(e, T.stroke, false, 0, 1)
    e.cur    = text(e, 11, T.sub, tostring(def))
    function e:place(x, y)
        self.label.Position = Vector2.new(x, y + 5)
        self.box.Position   = Vector2.new(x + self.win_w - 116, y + 3)
        self.box.Size       = Vector2.new(104, 18)
        self.stroke.Position= Vector2.new(x + self.win_w - 116, y + 3)
        self.stroke.Size    = Vector2.new(104, 18)
        self.cur.Position   = Vector2.new(x + self.win_w - 110, y + 6)
        self.cur.Text       = tostring(get(key))
        self.ox, self.oy    = x + self.win_w - 116, y + 22
    end
    e.pops = {}
    function e:build()
        for _, o in ipairs(self.pops) do kill(o) end
        self.pops = {}
        for i, opt in ipairs(self.opts) do
            local p = rect(e, T.panel2, true, 0)
            p.Position = Vector2.new(self.ox, self.oy + (i - 1) * 18)
            p.Size = Vector2.new(104, 18); p.ZIndex = 40; p.Visible = self.open
            local tx = text(e, 11, T.text, opt)
            tx.Position = Vector2.new(self.ox + 6, self.oy + (i - 1) * 18 + 3); tx.ZIndex = 41; tx.Visible = self.open
            table.insert(self.pops, p); table.insert(self.pops, tx)
        end
    end
    e.hit = function(x, y)
        if not e.match then return false end
        if self.open then
            for i in ipairs(self.opts) do
                local py = self.oy + (i - 1) * 18
                if x >= self.ox and x <= self.ox + 104 and y >= py and y <= py + 18 then
                    set(key, self.opts[i]); self.open = false
                    e:build(); if cb then cb(get(key)) end
                    return true
                end
            end
            self.open = false; e:build(); return true
        end
        local p = e.box.Position
        if x >= p.X and x <= p.X + p.Size.X and y >= p.Y and y <= p.Y + p.Size.Y then
            self.open = true; e:build(); return true
        end
        return false
    end
    e:place(0, 0)
    return e
end

function Section:Keybind(label, key, def)
    reg(key, def)
    local e = base(self, 24, label)
    e.box = rect(e, T.panel2, true, 0)
    e.brd = rect(e, T.stroke, false, 0, 1)
    e.txt = text(e, 11, T.sub, tostring(def), true)
    e.listen = false
    function e:place(x, y)
        self.label.Position = Vector2.new(x, y + 5)
        self.box.Position   = Vector2.new(x + self.win_w - 76, y + 3)
        self.box.Size       = Vector2.new(64, 18)
        self.brd.Position   = Vector2.new(x + self.win_w - 76, y + 3)
        self.brd.Size       = Vector2.new(64, 18)
        self.txt.Position   = Vector2.new(x + self.win_w - 44, y + 6)
        self.txt.Text       = self.listen and "[ ... ]" or tostring(get(key))
        self.txt.Color      = self.listen and accentColor() or T.sub
    end
    e.hit = function(x, y)
        if not e.match then return false end
        local p = self.box.Position
        if x >= p.X and x <= p.X + p.Size.X and y >= p.Y and y <= p.Y + p.Size.Y then
            self.listen = true; e:place(0, 0) return true
        end
        return false
    end
    e.key = function(name)
        if not self.listen then return false end
        set(key, name); self.listen = false; e:place(0, 0) return true
    end
    e:place(0, 0)
    return e
end

