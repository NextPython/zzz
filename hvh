            for _, s in ipairs(tab.sections) do
                for _, e in ipairs(s.items) do
                    if e.listen then e.key(input.KeyCode.Name) end
                end
            end
        end
        if gp then return end
        if input.KeyCode == menuKey then
            Lib.open = not Lib.open
            Lib:visible(Lib.open)
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Lib.open then
            Lib:click(input.Position.X, input.Position.Y)
        end
    end))

    track(UIS.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            Mouse.X, Mouse.Y = input.Position.X, input.Position.Y
            for _, tab in ipairs(Lib.tabs) do
                for _, s in ipairs(tab.sections) do
                    for _, e in ipairs(s.items) do
                        if e.update and e.drag then e.update(Mouse.X) end
                    end
                end
            end
        end
    end))

    track(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            for _, tab in ipairs(Lib.tabs) do
                for _, s in ipairs(tab.sections) do
                    for _, e in ipairs(s.items) do e.drag = false end
                end
            end
            Lib.drag = false
        end
    end))
end

-- Click routing sobre elementos
local function routeClick(x, y)
    for _, tab in ipairs(Lib.tabs) do
        if tab == Lib.tab then
            for _, s in ipairs(tab.sections) do
                for _, e in ipairs(s.items) do
                    if e.hit then local r = e.hit(x, y); if r then return end end
                end
            end
        end
    end
end

-- scroll
local function onScroll(dir)
    if not Lib.open or Lib.min or not Lib.tab then return end
    Lib.tab.scroll = clamp(Lib.tab.scroll - dir * 34, 0, math.max(0, (Lib.tab.total or 0) - (Lib.h - 60)))
    Lib.tab:layout()
end

--=====================================================================
-- [15] LOOP PRINCIPAL
--=====================================================================
local fps, frames, acc = 60, 0, 0
local function step(dt)
    if not _G.MHVH.running then return end
    getMouse()
    refreshSelf()

    if Lib.open and Lib.drag then
        local m = getMouse()
        Lib.x = m.X - Lib.dragOff.X
        Lib.y = m.Y - Lib.dragOff.Y
        Lib:apply()
    end

    if Lib.open and Lib.tab then Lib.tab:layout() end

    pcall(doAim, dt)
    pcall(doTrigger)
    pcall(doAA, dt)
    pcall(doMove)
    pcall(doFakeDuck)
    pcall(noRecoil)
    pcall(overlay)
    if get("esp.enabled") then pcall(drawESP) else
        for _, e in pairs(ESP) do hideESP(e) end
    end
    pcall(healthWatch)
    pcall(pushHist)
    pcall(drawNotifs, dt)

    -- FOV / third person
    if Camera then
        if get("misc.fov_change") then pcall(function() Camera.FieldOfView = get("misc.fov") end) end
        if get("misc.tp") then
            pcall(function()
                local d = get("misc.tp_dist")
                Camera.CFrame = Camera.CFrame - Camera.CFrame.LookVector * -d
                Camera.CFrame = Camera.CFrame + Camera.CFrame.LookVector * 0
            end)
        end
    end
end

local function boot()
    if RunService then
        track(RunService.RenderStepped:Connect(function(dt)
            local ok = pcall(step, dt)
        end))
    else
        task.spawn(function()
            while _G.MHVH.running do
                local t = os.clock()
                pcall(step, 1 / 60)
                task.wait()
            end
        end)
    end
end

