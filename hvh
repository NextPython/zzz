local T = {
    bg      = Color3.fromRGB(13, 13, 16),
    panel   = Color3.fromRGB(19, 19, 23),
    panel2  = Color3.fromRGB(26, 26, 32),
    stroke  = Color3.fromRGB(38, 38, 47),
    text    = Color3.fromRGB(234, 234, 240),
    sub     = Color3.fromRGB(124, 124, 140),
    ok      = Color3.fromRGB(92, 219, 143),
    bad     = Color3.fromRGB(240, 92, 92),
}
local FONT = {
    UI       = Drawing.Fonts.UI,
    Bold     = Drawing.Fonts.SystemBold,
    System   = Drawing.Fonts.System,
    Mono     = Drawing.Fonts.Monospace,
}
local ACCENT = { 126, 92, 255 }
local function accent(a)
    local c = Color3.fromRGB(ACCENT[1], ACCENT[2], ACCENT[3])
    if a then return c:Lerp(T.bg, a) end
    return c
end

local function rect(parent, color, filled, trans, thick)
    local o = mk("Square")
    if not o then return nil end
    o.Color = color
    o.Filled = filled and true or false
    o.Transparency = trans or 0
    o.Visible = false
    o.ZIndex = parent and parent.z or 2
    sp(o, "Corner", 0)
    if parent and parent.objects then table.insert(parent.objects, o) end
    return o
end

local function label(parent, size, color, str, center, font)
    local o = mk("Text")
    if not o then return nil end
    o.Text = str or ""
    o.FontSize = size or 12
    o.Color = color or T.text
    o.Center = center and true or false
    o.Font = font or FONT.UI
    o.Outline = true
    o.Visible = false
    o.ZIndex = parent and parent.z or 3
    if parent and parent.objects then table.insert(parent.objects, o) end
    return o
end

local function line(parent, color, thick)
    local o = mk("Line")
    if not o then return nil end
    o.Color = color or T.text
    o.Thickness = thick or 1
    o.Visible = false
    o.ZIndex = parent and parent.z or 3
    if parent and parent.objects then table.insert(parent.objects, o) end
    return o
end

local function circle(parent, color, thick, filled)
    local o = mk("Circle")
    if not o then return nil end
    o.Color = color or T.text
    o.Thickness = thick or 1
    o.Filled = filled and true or false
    o.NumSides = 64
    o.Visible = false
    o.ZIndex = parent and parent.z or 3
    if parent and parent.objects then table.insert(parent.objects, o) end
    return o
end

