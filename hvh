local Mouse = { X = 0, Y = 0 }
local mouseValid = false

local function getMouse()
    if LP then
        local ok, m = pcall(function() return LP:GetMouse() end)
        if ok and m then
            local ok2, x = pcall(function() return m.X end)
            if ok2 and type(x) == "number" then
                Mouse.X, Mouse.Y = m.X, m.Y
                mouseValid = true
                return Mouse
            end
        end
    end
    return Mouse
end
local function moveRel(dx, dy)
    pcall(mousemoverel, math.floor(dx + 0.5), math.floor(dy + 0.5))
    Mouse.X = Mouse.X + dx; Mouse.Y = Mouse.Y + dy
end
local function moveAbs(x, y)
    pcall(mousemoveabs, math.floor(x + 0.5), math.floor(y + 0.5))
    Mouse.X, Mouse.Y = x, y
end

