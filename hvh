local ESP = {}
local SKEL = {
    { "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" },
    { "LeftLowerArm", "LeftHand" }, { "UpperTorso", "RightUpperArm" },
    { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" },
    { "LeftLowerLeg", "LeftFoot" }, { "LowerTorso", "RightUpperLeg" },
    { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}

local function newESP()
    local e = { objects = {} }
    e.box    = rect(e, T.text, false, 0, 1)
    e.fill   = rect(e, T.text, true, 0.8)
    e.cham   = rect(e, T.text, false, 0, 2)
    e.name   = label(e, 12, T.text, "", true, FONT.Bold)
    e.hp     = label(e, 11, T.text, "", true, FONT.UI)
    e.ar     = label(e, 11, T.text, "", true, FONT.UI)
    e.wp     = label(e, 11, T.text, "", true, FONT.UI)
    e.ds     = label(e, 11, T.text, "", true, FONT.UI)
    e.tracer = line(e, T.text, 1)
    e.hit    = rect(e, T.bad, false, 0, 1)
    e.skel   = {}
    for i = 1, 14 do e.skel[i] = line(e, T.text, 1) end
    return e
end

local function espOf(p)
    if not ESP[p] then ESP[p] = newESP() end
    return ESP[p]
end

local function hide(e)
    for _, o in ipairs(e.objects) do sp(o, "Visible", false) end
    for _, l in ipairs(e.skel) do sp(l, "Visible", false) end
end

local function colOf(k, def)
    local t = get(k) or def
    return Color3.fromRGB(t[1], t[2], t[3])
end

local function espColor(p)
    if get("esp.team_color") and sameTeam(p) then return Color3.fromRGB(90, 200, 255) end
    if get("esp.health_color") then
        local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
        if h then
            local r = clamp(h.Health / math.max(h.MaxHealth, 1), 0, 1)
            return Color3.fromRGB(255 * (1 - r), 90 + 165 * r, 70)
        end
    end
    return colOf("esp.color", { 255, 255, 255 })
end

local function drawESP()
    local cam = camPos()
    for _, p in ipairs(Players:GetPlayers()) do
        local e = ESP[p]
        local skip = (p == LP) or not p.Character or not alive(p)
            or (get("esp.teamcheck") and sameTeam(p))
        if not skip then
            e = espOf(p)
            local hb = p.Character:FindFirstChild("HumanoidRootPart")
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local top = head and w2s(head.Position + Vector3.new(0, 0.65, 0))
            local bot = hb and w2s(hb.Position - Vector3.new(0, 2.7, 0))
            if top and bot and cam then
                local h = bot.Y - top.Y
                local w = math.max(2, h * 0.52)
                local x = top.X - w / 2
                local c = espColor(p)
                local dist = math.floor((cam - hb.Position).Magnitude)

                e.box.Visible = get("esp.box")
                e.box.Position = Vector2.new(x, top.Y)
                e.box.Size = Vector2.new(w, h)
                e.box.Color = c

                e.fill.Visible = get("esp.box") and get("esp.fill")
                e.fill.Position = e.box.Position
                e.fill.Size = e.box.Size
                e.fill.Color = c

                e.cham.Visible = get("esp.chams")
                e.cham.Position = Vector2.new(x - 2, top.Y - 2)
                e.cham.Size = Vector2.new(w + 4, h + 4)
                e.cham.Color = c

                e.name.Visible = get("esp.name")
                e.name.Text = p.Name
                e.name.Position = Vector2.new(top.X, top.Y - 17)
                e.name.Color = c

                e.hp.Visible = get("esp.health")
                e.hp.Text = "HP " .. math.floor(hum and hum.Health or 0)
                e.hp.Position = Vector2.new(top.X, bot.Y + 2)
                e.hp.Color = c

                e.ar.Visible = get("esp.armor")
                e.ar.Text = "AR " .. math.floor(tonumber(hb:GetAttribute("Armor")) or 0)
                e.ar.Position = Vector2.new(top.X, bot.Y + 14)
                e.ar.Color = c

                local wn = toolName(p)
                e.wp.Visible = get("esp.weapon") and wn ~= ""
                e.wp.Text = wn
                e.wp.Position = Vector2.new(top.X, bot.Y + 26)
                e.wp.Color = c

                e.ds.Visible = get("esp.dist")
                e.ds.Text = tostring(dist) .. "m"
                e.ds.Position = Vector2.new(top.X, bot.Y + 38)
                e.ds.Color = c

                if get("esp.tracer") then
                    e.tracer.Visible = true
                    local m = getMouse()
                    e.tracer.From = get("esp.tracer_origin") == "Mouse"
                        and Vector2.new(m.X, m.Y) or Vector2.new(center().X, viewport().Y - 40)
                    e.tracer.To = Vector2.new(top.X + w / 2, bot.Y)
                    e.tracer.Color = c
                else e.tracer.Visible = false end

                if get("esp.hitbox") and hb then
                    local hp = w2s(hb.Position)
                    e.hit.Visible = hp ~= nil
                    if hp then
                        e.hit.Position = Vector2.new(hp.X - 12, hp.Y - 12)
                        e.hit.Size = Vector2.new(24, 24)
                        e.hit.Color = colOf("esp.hb_color", { 255, 80, 80 })
                    end
                else e.hit.Visible = false end

                for i, pr in ipairs(SKEL) do
                    local l = e.skel[i]
                    if get("esp.skel") then
                        local a = p.Character:FindFirstChild(pr[1])
                        local b = p.Character:FindFirstChild(pr[2])
                        local sa = a and w2s(a.Position)
                        local sb = b and w2s(b.Position)
                        if sa and sb then
                            l.Visible = true; l.From = sa; l.To = sb; l.Color = c
                        else l.Visible = false end
                    else l.Visible = false end
                end
            else hide(e) end
        elseif e then hide(e) end
    end
end

