local T = {
    bg      = Color3.fromRGB(13, 13, 16),
    panel   = Color3.fromRGB(19, 19, 23),
    panel2  = Color3.fromRGB(25, 25, 31),
    stroke  = Color3.fromRGB(37, 37, 45),
    text    = Color3.fromRGB(232, 232, 238),
    sub     = Color3.fromRGB(126, 126, 142),
    accent  = Color3.fromRGB(126, 92, 255),
    ok      = Color3.fromRGB(92, 219, 143),
    bad     = Color3.fromRGB(240, 92, 92),
    font    = 2,
}
local ACCENT = { 126, 92, 255 }
local function accentColor(a)
    local c = Color3.fromRGB(ACCENT[1], ACCENT[2], ACCENT[3])
    if a then return c:Lerp(T.bg, a) end
    return c
end

local function rect(parent, color, filled, trans, thick)
    local o = mk("Square")
    if not o then return nil end
    o.Color = color; o.Filled = filled or false
    o.Transparency = trans or 0; o.Thickness = thick or 1
    o.Visible = false; o.ZIndex = parent and parent.z or 2
    if parent and parent.objects then table.insert(parent.objects, o) end
    return o
end
local function text(parent, size, color, str, center)
    local o = mk("Text")
    if not o then return nil end
    o.Text = str or ""; o.Size = size; o.Color = color
    o.Center = center or false; o.Font = T.font
    o.Outline = true; o.OutlineColor = Color3.new(0, 0, 0)
    o.Visible = false; o.ZIndex = parent and parent.z or 3
    if parent and parent.objects then table.insert(parent.objects, o) end
    return o
end
local function line(parent, color, thick)
    local o = mk("Line")
    if not o then return nil end
    o.Color = color; o.Thickness = thick or 1
    o.Transparency = 0; o.Visible = false
    o.ZIndex = parent and parent.z or 3
    if parent and parent.objects then table.insert(parent.objects, o) end
    return o
end

local UI = {}
UI.__index = UI

function UI.new(title, sub)
    local self = setmetatable({}, UI)
    self.objects, self.z = {}, 10
    self.tabs, self.tab = {}, nil
    self.x, self.y = 180, 140
    self.w, self.h = 720, 480
    self.open, self.min, self.search = true, false, ""
    self.drag, self.dragOff = false, Vector2.new()

    self.frame   = rect(self, T.bg, true, 0.04)
    self.outline = rect(self, T.stroke, false, 0, 1)
    self.bar     = rect(self, T.panel, true, 0)
    self.accentL = rect(self, accentColor(), true, 0)
    self.side    = rect(self, T.panel, true, 0)
    self.logo    = text(self, 15, T.text, title)
    self.logo2   = text(self, 11, T.sub, sub)
    self.close   = text(self, 15, T.sub, "×", true)
    self.mini    = text(self, 14, T.sub, "–", true)
    self.sBox    = rect(self, T.panel2, true, 0)
    self.sTxt    = text(self, 12, T.sub, "buscar...")
    self.content = rect(self, T.bg, true, 0)

    self:apply()
    return self
end

function UI:apply()
    local w, h = self.w, self.min and 42 or self.h
    self.frame.Position  = Vector2.new(self.x, self.y)
    self.frame.Size      = Vector2.new(w, h)
    self.outline.Position = Vector2.new(self.x, self.y)
    self.outline.Size     = Vector2.new(w, h)
    self.bar.Position    = Vector2.new(self.x, self.y)
    self.bar.Size        = Vector2.new(w, 42)
    self.accentL.Position = Vector2.new(self.x, self.y)
    self.accentL.Size    = Vector2.new(w, 2)
    self.side.Position   = Vector2.new(self.x, self.y + 42)
    self.side.Size       = Vector2.new(150, h - 42)
    self.logo.Position   = Vector2.new(self.x + 14, self.y + 9)
    self.logo2.Position  = Vector2.new(self.x + 14, self.y + 26)
    self.close.Position  = Vector2.new(self.x + w - 18, self.y + 12)
    self.mini.Position   = Vector2.new(self.x + w - 40, self.y + 12)
    self.sBox.Position   = Vector2.new(self.x + 160, self.y + 8)
    self.sBox.Size       = Vector2.new(w - 216, 26)
    self.sTxt.Position   = Vector2.new(self.x + 168, self.y + 13)
    self.content.Position = Vector2.new(self.x + 150, self.y + 42)
    self.content.Size     = Vector2.new(w - 150, h - 42)
    for _, t in ipairs(self.tabs) do t:layout() end
end

function UI:visible(v)
    for _, o in ipairs(self.objects) do if o then pcall(function() o.Visible = v end) end end
    if not v then
        for _, t in ipairs(self.tabs) do t:visible(false) end
    else
        for _, t in ipairs(self.tabs) do t:visible(t == self.tab) end
    end
end

function UI:Tab(name)
    local tab = { win = self, name = name, sections = {}, objects = {}, z = 11, scroll = 0, contentY = self.y + 50 }
    tab.btn     = rect(tab, T.panel, true, 0)
    tab.btnTxt  = text(tab, 12, T.sub, name)
    tab.pill    = rect(tab, accentColor(), true, 0)
    self.tabs[#self.tabs + 1] = tab
    if not self.tab then self:select(tab) end
    self:apply()
    return tab
end

function UI:select(tab)
    if self.tab then self.tab:visible(false) end
    self.tab = tab
    tab:visible(true)
    for _, t in ipairs(self.tabs) do
        local on = (t == tab)
        if t.btnTxt then t.btnTxt.Color = on and T.text or T.sub end
        if t.pill then t.pill.Visible = on end
        if t.btn then t.btn.Color = on and T.panel2 or T.panel end
    end
end

function UI:click(x, y)
    if not self.open then return end
    if x >= self.x + self.w - 26 and x <= self.x + self.w and y >= self.y + 6 and y <= self.y + 28 then
        self.open = false; self:visible(false); return "close" end
    if x >= self.x + self.w - 48 and x <= self.x + self.w - 28 and y >= self.y + 6 and y <= self.y + 28 then
        self.min = not self.min; self:apply(); return "min" end
    if not self.min and y >= self.y and y <= self.y + 42 then self.drag = true; self.dragOff = Vector2.new(x - self.x, y - self.y) end
    if self.min then return end
    for _, t in ipairs(self.tabs) do
        if x >= t.btn.Position.X and x <= t.btn.Position.X + t.btn.Size.X
        and y >= t.btn.Position.Y and y <= t.btn.Position.Y + t.btn.Size.Y then
            self:select(t) return
        end
    end
end

-- ---- Section ----
local Section = {}
Section.__index = Section
function Section.new(tab, name, desc)
    local s = setmetatable({}, Section)
    s.tab, s.items, s.objects, s.z = tab, {}, {}, 12
    s.h, s.baseY, s.x, s.pad = 30, 0, tab.win.x + 158, 12
    s.bg     = rect(s, T.panel, true, 0)
    s.stroke = rect(s, T.stroke, false, 0, 1)
    s.title  = text(s, 12, T.text, name)
    s.desc   = desc and text(s, 10, T.sub, desc) or nil
    s.y = 0
    table.insert(tab.sections, s)
    tab:layout()
    return s
end
function Section:visible(v)
    for _, o in ipairs(self.objects) do if o then pcall(function() o.Visible = v end) end end
    for _, e in ipairs(self.items) do e:visible(v and e.match) end
    self.on = v
end
function Section:layout()
    local y = self.desc and 42 or 30
    for _, e in ipairs(self.items) do
        if e.match then e.place(self.x + self.pad, self.baseY + y); y = y + e.h + 6 end
    end
    self.h = y + self.pad
    self.bg.Position     = Vector2.new(self.x, self.baseY)
    self.bg.Size         = Vector2.new(self.tab.win.w - 166, self.h)
    self.stroke.Position = Vector2.new(self.x, self.baseY)
    self.stroke.Size     = Vector2.new(self.tab.win.w - 166, self.h)
    self.title.Position  = Vector2.new(self.x + self.pad, self.baseY + 10)
    if self.desc then self.desc.Position = Vector2.new(self.x + self.pad, self.baseY + 25) end
end

function Section:search(q)
    for _, e in ipairs(self.items) do
        e.match = (q == "") or (e.label and e.label.Text:lower():find(q, 1, true) ~= nil)
    end
    self.tab:layout()
end

