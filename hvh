function Section:Colorpicker(label, key, def, cb)
    reg(key, def)
    local e = base(self, 24, label)
    e.preview = rect(e, Color3.fromRGB(def[1], def[2], def[3]), true, 0)
    e.brd     = rect(e, T.stroke, false, 0, 1)
    e.open    = false
    e.pops    = {}
    function e:place(x, y)
        self.label.Position = Vector2.new(x, y + 5)
        self.preview.Position = Vector2.new(x + self.win_w - 46, y + 4)
        self.preview.Size     = Vector2.new(34, 16)
        self.brd.Position     = Vector2.new(x + self.win_w - 46, y + 4)
        self.brd.Size         = Vector2.new(34, 16)
        self.ox, self.oy = x + self.win_w - 106, y + 24
    end
    function e:build()
        for _, o in ipairs(self.pops) do kill(o) end
        self.pops = {}
        for i = 0, 18 do
            local h = i / 18
            local c = Color3.fromHSV(h, 0.75, 1)
            local p = rect(e, c, true, 0)
            p.Position = Vector2.new(self.ox + i * 5, self.oy)
            p.Size = Vector2.new(5, 12); p.ZIndex = 40; p.Visible = self.open
            table.insert(self.pops, p)
        end
    end
    e.hit = function(x, y)
        if not e.match then return false end
        if self.open then
            if y >= self.oy and y <= self.oy + 12 and x >= self.ox and x <= self.ox + 95 then
                local h = clamp((x - self.ox) / 95, 0, 1)
                local c = Color3.fromHSV(h, 0.75, 1)
                set(key, { math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255) })
                self.preview.Color = c
                if cb then cb(get(key)) end
                return true
            end
            self.open = false; e:build(); return true
        end
        local p = self.preview.Position
        if x >= p.X and x <= p.X + 34 and y >= p.Y and y <= p.Y + 16 then
            self.open = true; e:build(); return true
        end
        return false
    end
    e:place(0, 0)
    return e
end

