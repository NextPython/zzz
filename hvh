local ESP = {}
local function espFor(p)
    if ESP[p] then return ESP[p] end
    local e = { objs = {} }
    local function add(c, col)
        local o = mk(c)
        if o then
            if col then o.Color = col end
            o.Visible = false
            table.insert(e.objs, o)
        end
        return o
    end
    e.box     = add("Square"); e.box.Filled = false; e.box.Thickness = 1
    e.fill    = add("Square"); e.fill.Filled = true; e.fill.Transparency = 0.75
    e.name    = add("Text"); e.name.Size = 12; e.name.Center = true; e.name.Font = 2
    e.health  = add("Text"); e.health.Size = 11; e.health.Center = true
    e.armor   = add("Text"); e.armor.Size = 11; e.armor.Center = true
    e.weapon  = add("Text"); e.weapon.Size = 11; e.weapon.Center = true
    e.dist    = add("Text"); e.dist.Size = 11; e.dist.Center = true
    e.tracer  = add("Line"); e.tracer.Thickness = 1
    e.hitbox  = add("Square"); e.hitbox.Filled = false
    e.skel    = {}
    for i = 1, 16 do e.skel[i] = add("Line"); e.skel[i].Thickness = 1 end
    ESP[p] = e
    return e
end

local function col(key, def)
    local t = get(key) or def
    return Color3.fromRGB(t[1], t[2], t[3])
end

local function espColor(p)
    local c = col("esp.color", { 255, 255, 255 })
    if get("esp.health_color") then
        local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
        if h then
            local r = h.Health / math.max(h.MaxHealth, 1)
            c = Color3.fromRGB(255 * (1 - r), 255 * r, 60)
        end
    end
    if get("esp.team_color") and teams(p) then c = Color3.fromRGB(90, 200, 255) end
    return c
end

local function hideESP(e)
    for _, o in ipairs(e.objs) do pcall(function() o.Visible = false end) end
    for _, l in ipairs(e.skel) do pcall(function() l.Visible = false end) end
end

local SKEL = {
    { "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" },
    { "LeftLowerArm", "LeftHand" }, { "UpperTorso", "RightUpperArm" },
    { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" },
    { "LeftLowerLeg", "LeftFoot" }, { "LowerTorso", "RightUpperLeg" },
    { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}

local function drawESP()
    local camPos = Camera and Camera.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        local e = ESP[p]
        if p ~= LP and p.Character and alive(p) and (not get("esp.teamcheck") or not teams(p)) then
            e = espFor(p)
            local hb = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            if hb and head and camPos then
                local top = w2s(head.Position + Vector3.new(0, 0.6, 0))
                local bot = w2s(hb.Position - Vector3.new(0, 2.6, 0))
                if top and bot then
                    local h = bot.Y - top.Y
                    local w = h * 0.55
                    local x = top.X - w / 2
                    local c = espColor(p)
                    local dist = math.floor((camPos - hb.Position).Magnitude)

                    e.box.Visible = get("esp.box")
                    e.box.Position = Vector2.new(x, top.Y); e.box.Size = Vector2.new(w, h); e.box.Color = c
                    e.fill.Visible = get("esp.box") and get("esp.fill")
                    e.fill.Position = e.box.Position; e.fill.Size = e.box.Size; e.fill.Color = c

                    e.name.Visible = get("esp.name")
                    e.name.Text = p.Name; e.name.Position = Vector2.new(top.X, top.Y - 16); e.name.Color = c

                    e.health.Visible = get("esp.health")
                    e.health.Text = "HP " .. math.floor(hum and hum.Health or 0)
                    e.health.Position = Vector2.new(top.X, bot.Y + 2); e.health.Color = c

                    e.armor.Visible = get("esp.armor")
                    e.armor.Text = "AR " .. math.floor(hb:GetAttribute("Armor") or 0)
                    e.armor.Position = Vector2.new(top.X, bot.Y + 14); e.armor.Color = c

                    e.weapon.Visible = get("esp.weapon") and toolName(p) ~= ""
                    e.weapon.Text = toolName(p)
                    e.weapon.Position = Vector2.new(top.X, bot.Y + 26); e.weapon.Color = c

                    e.dist.Visible = get("esp.dist")
                    e.dist.Text = tostring(dist) .. "m"
                    e.dist.Position = Vector2.new(top.X, bot.Y + 38); e.dist.Color = c

                    e.tracer.Visible = get("esp.tracer")
                    if e.tracer.Visible then
                        local m = getMouse()
                        e.tracer.From = get("esp.tracer_origin") == "Mouse" and Vector2.new(m.X, m.Y) or Vector2.new(center().X, center().Y + 300)
                        e.tracer.To = Vector2.new(top.X + w / 2, bot.Y)
                        e.tracer.Color = c
                    end

                    if get("esp.hitbox") then
                        e.hitbox.Visible = true
                        local hp = w2s(hb.Position)
                        if hp then
                            e.hitbox.Position = Vector2.new(hp.X - 12, hp.Y - 12)
                            e.hitbox.Size = Vector2.new(24, 24)
                            e.hitbox.Color = col("esp.hb_color", { 255, 80, 80 })
                        end
                    else e.hitbox.Visible = false end

                    if get("esp.skel") then
                        for i, pair in ipairs(SKEL) do
                            local a = p.Character:FindFirstChild(pair[1])
                            local b = p.Character:FindFirstChild(pair[2])
                            local l = e.skel[i]
                            if a and b then
                                local sa, sb = w2s(a.Position), w2s(b.Position)
                                if sa and sb then
                                    l.Visible = true; l.From = sa; l.To = sb; l.Color = c
                                else l.Visible = false end
                            else l.Visible = false end
                        end
                    else for _, l in ipairs(e.skel) do l.Visible = false end end
                else hideESP(e) end
            else hideESP(e) end
        elseif e then hideESP(e) end
    end
end

