function Section:Toggle(name, key, def, cb)
    reg(key, def)
    local e = base(self, 24, name)
    e.box    = rect(e, T.panel2, true, 0)
    e.stroke = rect(e, T.stroke, false, 0, 1)
    e.dot    = rect(e, T.sub, true, 0)
    sp(e.box, "Corner", 8)
    sp(e.stroke, "Corner", 8)
    sp(e.dot, "Corner", 6)
    function e:place(x, y)
        self.txtLabel.Position = Vector2.new(x, y + 5)
        self.box.Position      = Vector2.new(x + self.win_w - 40, y + 4)
        self.box.Size          = Vector2.new(34, 16)
        self.stroke.Position   = Vector2.new(x + self.win_w - 40, y + 4)
        self.stroke.Size       = Vector2.new(34, 16)
        local on = get(key)
        self.dot.Position = Vector2.new(on and (x + self.win_w - 24) or (x + self.win_w - 38), y + 6)
        self.dot.Size     = Vector2.new(12, 12)
        self.dot.Color    = on and accent() or T.sub
        self.txtLabel.Color = on and T.text or T.sub
    end
    e.hit = function(mx, my)
        if not e.match then return false end
        local p = e.box.Position
        if mx >= p.X - 6 and mx <= p.X + 44 and my >= p.Y - 4 and my <= p.Y + 24 then
            local v = not get(key)
            set(key, v)
            e:place(e.txtLabel.Position.X, e.txtLabel.Position.Y - 5)
            if cb then pcall(cb, v) end
            return true
        end
        return false
    end
    e:place(0, 0)
    return e
end

function Section:Slider(name, key, min, max, def, dec, suffix, cb)
    reg(key, def)
    local e = base(self, 38, name)
    e.val   = label(e, 12, accent(), tostring(def), false, FONT.UI)
    e.track = rect(e, T.panel2, true, 0)
    e.fill  = rect(e, accent(), true, 0)
    e.knob  = rect(e, T.text, true, 0)
    sp(e.track, "Corner", 2)
    sp(e.fill, "Corner", 2)
    sp(e.knob, "Corner", 3)
    e.min, e.max, e.dec, e.suffix, e.cb = min, max, dec or 0, suffix or "", cb
    e.drag = false
    function e:draw()
        local v = get(key)
        local a = (v - self.min) / (self.max - self.min)
        self.val.Text = string.format("%." .. self.dec .. "f%s", v, self.suffix)
        self.fill.Size = Vector2.new(self.track.Size.X * a, 4)
        self.knob.Position = Vector2.new(self.track.Position.X + self.track.Size.X * a - 3, self.track.Position.Y - 3)
    end
    function e:place(x, y)
        self.txtLabel.Position = Vector2.new(x, y + 2)
        self.val.Position      = Vector2.new(x + self.win_w - 52, y + 2)
        self.track.Position    = Vector2.new(x, y + 22)
        self.track.Size        = Vector2.new(self.win_w - 52, 4)
        self.fill.Position     = Vector2.new(x, y + 22)
        self.knob.Size         = Vector2.new(6, 10)
        self:draw()
    end
    e.hit = function(mx, my)
        if not e.match then return false end
        local p = e.track.Position
        if mx >= p.X - 4 and mx <= p.X + e.track.Size.X + 4 and my >= p.Y - 8 and my <= p.Y + 14 then
            e.drag = true
            return true
        end
        return false
    end
    e.update = function(mx)
        if not e.drag then return end
        local p = e.track.Position
        local a = clamp((mx - p.X) / math.max(e.track.Size.X, 1), 0, 1)
        local m = 10 ^ e.dec
        set(key, math.floor((self.min + (self.max - self.min) * a) * m + 0.5) / m)
        e:draw()
        if e.cb then pcall(e.cb, get(key)) end
    end
    e:place(0, 0)
    return e
end

function Section:Dropdown(name, key, options, def, cb)
    reg(key, def)
    local e = base(self, 24, name)
    e.opts, e.open, e.pops = options, false, {}
    e.box    = rect(e, T.panel2, true, 0)
    e.stroke = rect(e, T.stroke, false, 0, 1)
    e.cur    = label(e, 11, T.sub, tostring(def), false, FONT.UI)
    sp(e.box, "Corner", 3)
    sp(e.stroke, "Corner", 3)
    function e:place(x, y)
        self.txtLabel.Position = Vector2.new(x, y + 5)
        self.box.Position      = Vector2.new(x + self.win_w - 116, y + 3)
        self.box.Size          = Vector2.new(104, 18)
        self.stroke.Position   = Vector2.new(x + self.win_w - 116, y + 3)
        self.stroke.Size       = Vector2.new(104, 18)
        self.cur.Position      = Vector2.new(x + self.win_w - 110, y + 6)
        self.cur.Text          = tostring(get(key))
        self.ox, self.oy       = x + self.win_w - 116, y + 22
    end
    function e:build()
        for _, o in ipairs(self.pops) do kill(o) end
        self.pops = {}
        for i, opt in ipairs(self.opts) do
            local bg = rect(e, T.panel2, true, 0)
            bg.Position = Vector2.new(self.ox, self.oy + (i - 1) * 18)
            bg.Size = Vector2.new(104, 18); bg.ZIndex = 40; bg.Visible = self.open
            sp(bg, "Corner", 2)
            local tx = label(e, 11, T.text, opt, false, FONT.UI)
            tx.Position = Vector2.new(self.ox + 6, self.oy + (i - 1) * 18 + 3)
            tx.ZIndex = 41; tx.Visible = self.open
            table.insert(self.pops, bg); table.insert(self.pops, tx)
        end
    end
    e.hit = function(mx, my)
        if not e.match then return false end
        if self.open then
            for i in ipairs(self.opts) do
                local py = self.oy + (i - 1) * 18
                if mx >= self.ox and mx <= self.ox + 104 and my >= py and my <= py + 18 then
                    set(key, self.opts[i]); self.open = false; e:build()
                    if cb then pcall(cb, get(key)) end
                    return true
                end
            end
            self.open = false; e:build(); return true
        end
        local p = e.box.Position
        if mx >= p.X and mx <= p.X + p.Size.X and my >= p.Y and my <= p.Y + p.Size.Y then
            self.open = true; e:build(); return true
        end
        return false
    end
    e:place(0, 0)
    return e
end

function Section:Keybind(name, key, def)
    reg(key, def)
    local e = base(self, 24, name)
