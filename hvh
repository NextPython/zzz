local yaw, invert = 0, 1
local function doAA(dt)
    if not get("aa.enabled") or not HRP then return end
    if get("aa.inverter") then invert = -1 else invert = 1 end

    local base = math.deg(math.atan2(-Camera.CFrame.LookVector.X, -Camera.CFrame.LookVector.Z))
    local target = base + get("aa.yaw_offset")

    if get("aa.spin") then
        yaw = yaw + get("aa.spin_speed") * 60 * dt
    elseif get("aa.jitter") then
        yaw = target + (math.random() > 0.5 and get("aa.jitter_range") or -get("aa.jitter_range"))
    elseif get("aa.random") then
        if math.random() > 0.85 then yaw = target + (math.random() - 0.5) * 180 end
    elseif get("aa.static") then
        yaw = get("aa.static_yaw")
    else
        yaw = target
    end

    yaw = yaw * invert

    if get("aa.lby") and Hum then
        local st = Hum.MoveDirection.Magnitude
        if st < 0.1 then yaw = yaw + (os.clock() % 1 > 0.5 and 35 or -35) end
    end
    if get("aa.fake_flick") and math.random() > 0.94 then yaw = yaw + math.random(-90, 90) end

    local pitch = get("aa.pitch")
    if get("aa.fake_pitch") then pitch = (math.floor(os.clock() * 6) % 2 == 0) and 89 or -89 end

    local ok = pcall(function()
        HRP.CFrame = CFrame.new(HRP.Position) * CFrame.Angles(math.rad(pitch), math.rad(yaw), 0)
    end)
    if ok and get("aa.desync") then
        pcall(function() HRP.CFrame = HRP.CFrame * CFrame.new(get("aa.desync_amt") / 100, 0, 0) end)
    end
end

