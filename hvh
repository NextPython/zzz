local lastHP = {}
local function healthWatch()
    for _, p in ipairs(Players:GetPlayers()) do
        local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
        if h then
            local prev = lastHP[p] or h.MaxHealth
            if h.Health < prev - 0.5 then
                local dmg = math.floor(prev - h.Health)
                if dmg > 0 and dmg < 250 then
                    if get("info.hitlog") then
                        Notify("HIT", string.format("%s  -%d", p.Name, dmg), T.ok)
                    end
                end
            end
            lastHP[p] = h.Health
        else lastHP[p] = nil end
    end
end

local function noRecoil()
    if not get("wpn.no_recoil") then return end
    local ok, rot = pcall(function() return Camera.CFrame.Rotation end)
    if not ok or not rot then return end
    local pitch = math.asin(clamp(rot.LookVector.Y, -1, 1))
    if math.abs(pitch) < 0.015 then return end
    pcall(function()
        Camera.CFrame = Camera.CFrame * CFrame.Angles(-pitch * (get("wpn.recoil_amt") / 100), 0, 0)
    end)
end

