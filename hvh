local HITBOXES = { "Head", "UpperTorso", "HumanoidRootPart", "LowerTorso", "Torso" }

local function getHitbox(p)
    local mode = get("aim.hitbox")
    local c = p.Character
    if mode == "Nearest" then
        local best, bd
        local m = getMouse()
        for _, n in ipairs(HITBOXES) do
            local part = c:FindFirstChild(n)
            if part then
                local sp = w2s(part.Position)
                if sp then
                    local d = (sp - Vector2.new(m.X, m.Y)).Magnitude
                    if not bd or d < bd then bd, best = d, part end
                end
            end
        end
        return best
    end
    return c:FindFirstChild(mode) or c:FindFirstChild("HumanoidRootPart")
end

local function valid(p)
    if p == LP or not p.Character then return false end
    if get("aim.teamcheck") and teams(p) then return false end
    if get("aim.alive") and not alive(p) then return false end
    if get("aim.wallcheck") and not visible(p.Character:FindFirstChild("HumanoidRootPart")) then return false end
    return true
end

local Target
local function acquire()
    local m = getMouse()
    local mp = Vector2.new(m.X, m.Y)
    local fov = get("aim.fov")
    local best, bd = nil, fov
    for _, p in ipairs(Players:GetPlayers()) do
        if valid(p) then
            local hb = getHitbox(p)
            if hb then
                local sp = w2s(hb.Position)
                if sp then
                    local d = (sp - mp).Magnitude
                    if d < bd then bd, best = d, p end
                end
            end
        end
    end
    return best
end

local function aimPoint(p)
    local hb = getHitbox(p)
    if not hb then return nil end
    local pos = hb.Position
    if get("aim.prediction") > 0 and hb.AssemblyLinearVelocity then
        pos = pos + hb.AssemblyLinearVelocity * (get("aim.prediction") / 1000)
    end
    if get("aim.multipoint") then
        local s = hb.Size * (get("aim.mp_scale") / 100)
        local seed = math.floor(os.clock() * 12)
        local rx = ((seed * 37) % 100 / 50 - 1) * s.X
        local ry = ((seed * 71) % 100 / 50 - 1) * s.Y
        pos = pos + Vector3.new(rx, ry, 0)
    end
    if get("aim.backtrack") then
        local list = Hist[p]
        if list and #list > 2 then
            local idx = math.max(1, #list - math.floor(get("aim.bt_amount")))
            pos = list[idx].pos
        end
    end
    return pos
end

local function hitchance(p)
    local hb = getHitbox(p)
    if not hb then return 0 end
    local hits, total = 0, 8
    for i = 1, total do
        local off = Vector3.new(
            (math.random() - 0.5) * hb.Size.X,
            (math.random() - 0.5) * hb.Size.Y,
            0)
        local sp, on = w2s(hb.Position + off)
        if sp and on then hits = hits + 1 end
    end
    return (hits / total) * 100
end

local function resolveAngle(p)
    local hb = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    if not hb then return nil end
    local mode = get("aim.resolver")
    if mode == "Off" then return hb.Position end
    local v = hb.AssemblyLinearVelocity
    if mode == "Velocity" or (mode == "Adaptive" and v.Magnitude > 6) then
        return hb.Position + (v.Unit * (hb.Size.Z / 2))
    end
    return hb.Position
end

