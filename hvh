local Cfg, Defaults = {}, {}
local function reg(key, def)
    Defaults[key] = def
    if Cfg[key] == nil then Cfg[key] = def end
end
local function get(key) return Cfg[key] end
local function set(key, v) Cfg[key] = v end

local DIR = "matcha_hvh"
local function ensureDir()
    if API.isFolder and API.makeFolder and not API.isFolder(DIR) then pcall(API.makeFolder, DIR) end
end
local function serialize()
    local out = { "-- matcha_hvh config" }
    for k, d in pairs(Defaults) do
        local v = Cfg[k]
        local tv = type(v)
        if tv == "boolean" or tv == "number" or tv == "string" then
            table.insert(out, k .. "=" .. tostring(v))
        elseif tv == "table" and #v == 3 then
            table.insert(out, k .. "=" .. table.concat(v, ","))
        end
    end
    return table.concat(out, "\n")
end
local function deserialize(txt)
    for line in txt:gmatch("[^\r\n]+") do
        if not line:match("^%-%-") then
            local k, v = line:match("^([%w_%.]+)=(.*)$")
            if k and Defaults[k] ~= nil then
                local dt = type(Defaults[k])
                if dt == "boolean" then Cfg[k] = (v == "true")
                elseif dt == "number" then Cfg[k] = tonumber(v) or Defaults[k]
                elseif dt == "string" then Cfg[k] = v
                elseif dt == "table" then
                    local t = {}
                    for n in v:gmatch("[^,]+") do table.insert(t, tonumber(n) or 0) end
                    if #t == 3 then Cfg[k] = t end
                end
            end
        end
    end
end
local function saveConfig(name)
    if not API.writeFile then return false end
    ensureDir()
    local ok = pcall(API.writeFile, DIR .. "/" .. name .. ".cfg", serialize())
    return ok
end
local function loadConfig(name)
    if not API.readFile then return false end
    local ok, txt = pcall(API.readFile, DIR .. "/" .. name .. ".cfg")
    if ok and txt then deserialize(txt) return true end
    return false
end

