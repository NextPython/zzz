local Notifs = {}
function Lib_Notify(title, body, color)
    local n = { life = 4 }
    n.bg   = mk("Square"); n.bg.Filled = true; n.bg.Color = T.panel2; n.bg.Transparency = 0.05
    n.brd  = mk("Square"); n.brd.Filled = false; n.brd.Color = color or accentColor(); n.brd.Thickness = 1
    n.acc  = mk("Square"); n.acc.Filled = true; n.acc.Color = color or accentColor()
    n.t1   = mk("Text"); n.t1.Text = title; n.t1.Size = 12; n.t1.Color = T.text; n.t1.Font = 2
    n.t2   = mk("Text"); n.t2.Text = body; n.t2.Size = 11; n.t2.Color = T.sub; n.t2.Font = 2
    table.insert(Notifs, n)
end
local function drawNotifs(dt)
    local y = 60
    for i = #Notifs, 1, -1 do
        local n = Notifs[i]
        n.life = n.life - dt
        if n.life <= 0 then
            for _, o in ipairs({ n.bg, n.brd, n.acc, n.t1, n.t2 }) do kill(o) end
            table.remove(Notifs, i)
        else
            local x = 20
            n.bg.Position = Vector2.new(x, y); n.bg.Size = Vector2.new(210, 42)
            n.brd.Position = Vector2.new(x, y); n.brd.Size = Vector2.new(210, 42)
            n.acc.Position = Vector2.new(x, y); n.acc.Size = Vector2.new(2, 42)
            n.t1.Position = Vector2.new(x + 10, y + 7)
            n.t2.Position = Vector2.new(x + 10, y + 23)
            y = y + 50
        end
    end
end

