local function svc(name)
    local ok, r = pcall(function() return game:GetService(name) end)
    if ok then return r end
end

local Players    = svc("Players")
local RunService = svc("RunService")
local UIS        = svc("UserInputService")
local Workspace  = svc("Workspace")
local HttpService= svc("HttpService")

local Camera = Workspace and Workspace.CurrentCamera
local LP     = Players and Players.LocalPlayer

local function track(c) table.insert(_G.MHVH.conns, c) return c end
local function mk(class)
    local ok, o = pcall(function() return Drawing.new(class) end)
    if ok and o then table.insert(_G.MHVH.objs, o) return o end
end
local function kill(o) if o then pcall(function() o:Remove() end) end end
local function sp(o, k, v) pcall(function() o[k] = v end) end

local function lerp(a, b, t) return a + (b - a) * t end
local function clamp(v, a, b) return v < a and a or (v > b and b or v) end
local function now() return tick() end

-- timers (task.delay es no-op en este build)
local function after(sec, fn)
    table.insert(_G.MHVH.timers, { t = now() + sec, fn = fn })
end
local function runTimers()
    local t = now()
    for i = #_G.MHVH.timers, 1, -1 do
        local e = _G.MHVH.timers[i]
        if t >= e.t then
            table.remove(_G.MHVH.timers, i)
            pcall(e.fn)
        end
    end
end

