local Store = { data = { toggles = {}, sliders = {}, drops = {}, texts = {}, keys = {}, colors = {}, pos = {} } }
Store.path = CFG_DIR .. "/autosave.json"

do
    if type(readfile) == "function" then
        pcall(function()
            local raw = readfile(Store.path)
            if type(raw) == "string" and #raw > 1 then
                local ok, dec = pcall(HttpService.JSONDecode, HttpService, raw)
                if ok and type(dec) == "table" then Store.data = dec end
            end
        end)
    end
    for _, k in ipairs({ "toggles", "sliders", "drops", "texts", "keys", "colors", "pos" }) do
        if type(Store.data[k]) ~= "table" then Store.data[k] = {} end
    end
end

local writeToken = 0
function Store.Flush()
    if type(writefile) ~= "function" then return end
    pcall(function() writefile(Store.path, HttpService:JSONEncode(Store.data)) end)
end
function Store.Save()
    writeToken += 1
    local tok = writeToken
    task.delay(0.45, function()
        if tok == writeToken then Store.Flush() end
    end)
end
function Store.Get(bucket, key, fallback)
    local s = Store.data[bucket]
    local v = s and s[key]
    if v == nil then return fallback end
    return v
end
function Store.Set(bucket, key, value)
    local s = Store.data[bucket]; if not s then s = {}; Store.data[bucket] = s end
    s[key] = value
    Store.Save()
end
function Store.Pos(key, fallback)
    local p = Store.data.pos[key]
    if type(p) == "table" and #p == 4 then return UDim2.new(p[1], p[2], p[3], p[4]) end
    return fallback
end
function Store.SetPos(key, p)
    Store.data.pos[key] = { p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset }
    Store.Save()
end

