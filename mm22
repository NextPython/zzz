local Roles = { murderer = nil, sheriff = nil, hero = nil, cache = {}, rev = 0, subs = {} }

local function subscribe(fn)
    Roles.subs[#Roles.subs + 1] = fn
    return function() Roles.subs[#Roles.subs] = nil end
end
local function emitRoles()
    Roles.rev += 1
    for _, fn in ipairs(Roles.subs) do pcall(fn, Roles.rev) end
end

local function charOf(p) return p and p.Character end
local function humOf(p)
    local c = charOf(p)
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function alive(p)
    local h = humOf(p)
    return p ~= nil and p ~= LP and h ~= nil and h.Health > 0
end
local function hasTool(p, name)
    local c, b = charOf(p), p and p:FindFirstChildOfClass("Backpack")
    return (c and c:FindFirstChild(name)) or (b and b:FindFirstChild(name))
end
local function rootOf(p)
    local c = charOf(p)
    return c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
end

local function localRoot()
    local c = LP.Character
    return c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
end
local function localHum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local friends = {}
local function isFriend(p)
    if friends[p] ~= nil then return friends[p] end
    local ok, r = pcall(function() return p:IsFriendsWith(LP.UserId) end)
    friends[p] = ok and r == true
    return friends[p]
end

local function refreshRoles(force)
    local murder, sheriff, hero
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local role = Roles.cache[p.UserId]
            if role == "murderer" then murder = p
            elseif role == "sheriff" then sheriff = p
            elseif role == "hero" then hero = p end
        end
    end
    if not murder then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and alive(p) and hasTool(p, "Knife") then murder = p; break end
        end
    end
    if not sheriff then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and alive(p) and hasTool(p, "Gun") then sheriff = p; break end
        end
    end
    local changed = Roles.murderer ~= murder or Roles.sheriff ~= sheriff or Roles.hero ~= hero
    Roles.murderer, Roles.sheriff, Roles.hero = murder, sheriff, hero
    if changed or force then emitRoles() end
end

