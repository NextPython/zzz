    activePage = id
    Store.Set("drops", "Noir::Page", id)
    for pid, page in pairs(pages) do page.Visible = (pid == id) end
    for nid, b in pairs(navButtons) do
        local on = nid == id
        TweenService:Create(b, TweenInfo.new(0.18), {
