-- Slider
local function addSlider(body, key, label, min, max, default, cb)
    local full = key .. "::" .. label
    local saved = tonumber(Store.Get("sliders", full, default)) or default
    local r = row(body, label, 32)
    local val = mk("TextLabel", { Parent = r, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(52, 18), BackgroundTransparency = 1, Text = tostring(saved),
        TextColor3 = T.accent2, TextSize = 12, Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right }, nil)
    local track = mk("Frame", { Parent = r, Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 4),
        BackgroundColor3 = T.off, BorderSizePixel = 0 }, nil)
    corner(track, 2)
    local fill = mk("Frame", { Parent = track, Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = T.accent, BorderSizePixel = 0 }, nil)
    corner(fill, 2)

    local current = saved
    local function draw(v)
        local a = (v - min) / math.max(max - min, 0.001)
        fill.Size = UDim2.fromScale(a, 1)
        val.Text = tostring(math.floor(v + 0.5))
    end
    local function set(v, save)
        current = math.clamp(math.floor((tonumber(v) or current) + 0.5), min, max)
        draw(current)
        cb(current)
        if save ~= false then Store.Set("sliders", full, current) end
    end
    draw(current)

    local dragging = false
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            set(min + (max - min) * math.clamp((i.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1))
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not dragging then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
            set(min + (max - min) * math.clamp((i.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1))
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    set(saved, false)
    return { Set = function(_, v) set(v) end, Get = function() return current end }
end

