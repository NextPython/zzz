local Gun = { remote = nil }

local function findGunRemote()
    local gun = gunTool()
    if not gun then return nil end
    if Gun.remote and Gun.remote.Parent then return Gun.remote end
    for _, o in ipairs(gun:GetDescendants()) do
        if o:IsA("RemoteEvent") and o.Name == "Shoot" then Gun.remote = o; return o end
