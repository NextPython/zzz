    local cam, part = workspace.CurrentCamera, aimPart(p)
    if not cam or not part then return false end
    local sp = cam:WorldToViewportPoint(part.Position)
    local c = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    return (Vector2.new(sp.X, sp.Y) - c).Magnitude <= Aim.fov / 2
end

local function passes(p, trusted)
    if not alive(p) then return false end
    if not trusted and isFriend(p) and Aim.friends then return false end
    if Aim.maxDist > 0 then
        local a, b = localRoot(), rootOf(p)
        if a and b and (a.Position - b.Position).Magnitude > Aim.maxDist then return false end
    end
    return true
end

local function pickTarget()
    local mode = Aim.mode
    if mode == "Murderer" then return passes(Roles.murderer, true) and Roles.murderer or nil end
    if mode == "Sheriff" then return passes(Roles.sheriff, true) and Roles.sheriff or nil end
    if mode == "Selected" then
        local p = Aim.selected and Players:FindFirstChild(Aim.selected)
        return p and passes(p, true) and p or nil
    end
    if mode == "Nearest" then
        local best, bd
        local root = localRoot()
        for _, p in ipairs(Players:GetPlayers()) do
            if passes(p) then
                local r = rootOf(p)
                if root and r then
                    local d = (r.Position - root.Position).Magnitude
                    if not bd or d < bd then best, bd = p, d end
                end
            end
        end
        return best
    end
    if mode == "Random" then
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do if passes(p) then list[#list + 1] = p end end
        return #list > 0 and list[math.random(#list)] or nil
    end
    if mode == "Lowest Health" then
        local best, bh
        for _, p in ipairs(Players:GetPlayers()) do
            if passes(p) then
                local h = humOf(p)
                local hp = h and h.Health or math.huge
                if not bh or hp < bh then best, bh = p, hp end
            end
        end
        return best
    end
    return passes(Roles.murderer, true) and Roles.murderer or nil
end

local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude
wallParams.IgnoreWater = true

local function visible(part)
    if not Aim.wall then return true end
    local c = LP.Character
    local from = c and (c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart"))
    if not from or not part then return false end
    wallParams.FilterDescendantsInstances = { c }
    local hit = workspace:Raycast(from.Position, part.Position - from.Position, wallParams)
    return hit == nil or hit.Instance:IsDescendantOf(part.Parent)
end

-- Predicción ligera, sin tablas por frame
local function predict(part)
    local pos = part.Position
    if not Aim.pred then
        return pos + Vector3.new(0, part.Size.Y * Aim.yOff / 100, 0)
    end
    local vel = part.AssemblyLinearVelocity
    local t = math.clamp(ping + Aim.lead / 1000, 0.02, 0.28)
    local disp = Vector3.new(vel.X * Aim.hMul / 100 * t, 0, vel.Z * Aim.hMul / 100 * t)
    if vel.Y > 2 or vel.Y < -2 then
        disp = disp + Vector3.new(0, vel.Y * Aim.vMul / 100 * t, 0)
    end
    if disp.Magnitude > 20 then disp = disp.Unit * 20 end
    return pos + disp + Vector3.new(0, part.Size.Y * Aim.yOff / 100, 0)
end

--============================== HOOK ================================
local hooked = false

local function gunTool()
    local c, b = LP.Character, LP:FindFirstChildOfClass("Backpack")
    return (c and c:FindFirstChild("Gun")) or (b and b:FindFirstChild("Gun"))
end
local function knifeTool()
    local c, b = LP.Character, LP:FindFirstChildOfClass("Backpack")
    return (c and c:FindFirstChild("Knife")) or (b and b:FindFirstChild("Knife"))
end

local function ownsRemote(remote)
    local tool = remote:FindFirstAncestorOfClass("Tool")
    if not tool then return false end
    local c, b = LP.Character, LP:FindFirstChildOfClass("Backpack")
    return (c and tool:IsDescendantOf(c)) or (b and tool:IsDescendantOf(b))
end

local function redirect(remote, args)
    local part, isKnife
    if remote.Name == "KnifeThrown" then
        local p = Knife.targetPlayer()
        part = p and aimPart(p); isKnife = true
    else
        if not (Aim.enabled or Trigger.active) then return end
        if not ownsRemote(remote) then return end
        local p = (Trigger.pending) or pickTarget()
        part = p and aimPart(p)
    end
    if not part then return end
    if Aim.wall and not visible(part) then return end

    local aim = predict(part)
    if isKnife then
        local o = args[1].Position
        if (aim - o).Magnitude > 0.01 then args[1] = CFrame.lookAt(o, aim) end
        args[2] = CFrame.new(aim)
        return
    end
    if typeof(args[1]) ~= "CFrame" then return end
    local o = args[1].Position
    if (aim - o).Magnitude > 0.01 then args[1] = CFrame.lookAt(o, aim) end
    args[2] = CFrame.new(aim)
end

local function installHook()
    if hooked then return true end
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
        return false
    end
    local wrap = type(newcclosure) == "function" and newcclosure or function(f) return f end
    local caller = type(checkcaller) == "function" and checkcaller or function() return false end
    local ok = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
            if getnamecallmethod() == "FireServer" and typeof(self) == "Instance" and self.ClassName == "RemoteEvent" and not caller() then
                if self.Name == "KnifeThrown" or self.Name == "Shoot" then
                    local args = table.pack(...)
                    pcall(redirect, self, args)
                    return old(self, table.unpack(args, 1, args.n))
                end
            end
            return old(self, ...)
        end))
    end)
    hooked = ok
    return ok
end

