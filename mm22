local busy = false
function FireGunAt(p)
    if busy or not alive(p) then return false end
    busy = true
    local ok = pcall(function()
        local part = aimPart(p)
        local hum, char = localHum(), LP.Character
        if not part or not hum or not char then return end
        if Aim.wall and not visible(part) then return end
        local gun = gunTool()
        if not gun then return end
        if gun.Parent ~= char then hum:EquipTool(gun); task.wait(0.09) end
        local remote = findGunRemote()
        local handle = gun:FindFirstChild("Handle", true)
        if not remote or not handle then return end
        local aim = predict(part)
        remote:FireServer(CFrame.lookAt(handle.Position, aim), CFrame.new(aim))
    end)
    task.wait(0.08)
    busy = false
    return ok
end

local Trigger = { active = false, pending = nil, last = 0 }

RunService.RenderStepped:Connect(function()
    if not Trigger.active then Trigger.pending = nil; return end
    local p = pickTarget()
    if not p then Trigger.pending = nil; return end
    local cam, part = workspace.CurrentCamera, aimPart(p)
    if not cam or not part then return end
    local sp = cam:WorldToViewportPoint(part.Position)
    if sp.Z < 0 then return end
    local c = cam.ViewportSize / 2
    if (Vector2.new(sp.X, sp.Y) - Vector2.new(c.X, c.Y)).Magnitude > 30 then return end
    if Aim.wall and not visible(part) then return end
    Trigger.pending = p
    local now = os.clock()
    if now - Trigger.last > 0.3 then
        Trigger.last = now
        task.spawn(FireGunAt, p)
    end
end)

