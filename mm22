local espAcc = 0
RunService.Heartbeat:Connect(function(dt)
    if not ESP.on then
        if next(ESP.data) then
            for p in pairs(ESP.data) do espClear(p) end
        end
        return
    end
    espAcc += dt
    if espAcc < 0.05 then return end
    espAcc = 0

    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local origin = Vector2.new(vp.X / 2, vp.Y)

    local seen = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) then
            local r, h = rootOf(p), humOf(p)
            if r and h then
                seen[p] = true
                local d = espFor(p)
                local top = cam:WorldToViewportPoint(r.Position + Vector3.new(0, 2.6, 0))
                local bot = cam:WorldToViewportPoint(r.Position - Vector3.new(0, 2.8, 0))
                local onScreen = top.Z > 0 and bot.Z > 0
                local hgt = math.abs(top.Y - bot.Y)
                local wid = hgt * 0.55
                d.box.Visible = ESP.box and onScreen
                d.name.Visible = ESP.name and onScreen
                d.tracer.Visible = ESP.tracer and onScreen
                d.hpBg.Visible = ESP.health and onScreen
                if onScreen then
                    d.box.Position = UDim2.fromOffset(top.X - wid / 2, top.Y)
                    d.box.Size = UDim2.fromOffset(wid, hgt)
                    d.name.Position = UDim2.fromOffset(top.X - 70, top.Y - 16)
                    d.name.Text = ESP.name and (p.Name .. "  [" .. math.floor((r.Position - (localRoot() and localRoot().Position or r.Position)).Magnitude) .. "]") or ""
                    if ESP.health then
                        local frac = math.clamp(h.Health / math.max(h.MaxHealth, 1), 0, 1)
                        d.hpBg.Position = UDim2.fromOffset(top.X - wid / 2 - 5, top.Y)
                        d.hpBg.Size = UDim2.fromOffset(3, hgt)
                        d.hpFill.Size = UDim2.fromScale(1, frac)
                        d.hpFill.Position = UDim2.fromScale(0, 1 - frac)
                        d.hpFill.BackgroundColor3 = T.bad:Lerp(T.ok, frac)
                    end
                    if ESP.tracer then
                        local dx, dy = top.X - origin.X, top.Y - origin.Y
                        local len = math.sqrt(dx * dx + dy * dy)
                        d.tracer.AnchorPoint = Vector2.new(0, 0.5)
                        d.tracer.Position = UDim2.fromOffset(origin.X, origin.Y)
                        d.tracer.Size = UDim2.fromOffset(len, 1)
                        d.tracer.Rotation = math.deg(math.atan2(dy, dx))
                    end
                end
                d.hl.Enabled = ESP.chams
                local role = Roles.cache[p.UserId]
                local col = role == "murderer" and T.bad or (role == "sheriff" and T.ok or T.accent)
                d.hl.FillColor = col
                d.hl.OutlineColor = col
            end
        end
    end
    for p in pairs(ESP.data) do
        if not seen[p] then espClear(p) end
    end
end)

