local Knife = { enabled = false, prioritySheriff = false, autoKill = false, stabCD = {} }

function Knife.targetPlayer()
    if not Knife.enabled then return nil end
    if Knife.prioritySheriff then
        return passes(Roles.sheriff, true) and Roles.sheriff or nil
    end
    local best, bd
    local root = localRoot()
    for _, p in ipairs(Players:GetPlayers()) do
        if passes(p) then
            local r = rootOf(p)
            if root and r then
                local d = (r.Position - root.Position).Magnitude
                if not bd or d < bd then best, bd = p, d end
            end
        end
    end
    return best
end

function Knife.Stab(p)
    if not alive(p) then return false end
    local tool = knifeTool()
    local char = charOf(p)
    if not tool or not char then return false end
    local now = os.clock()
    if now - (Knife.stabCD[p] or 0) < 0.1 then return false end
    Knife.stabCD[p] = now
    if tool.Parent ~= LP.Character then
        local hum = localHum(); if hum then hum:EquipTool(tool) end
    end
    local handle = tool:FindFirstChild("Handle", true)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if handle and hrp and type(firetouchinterest) == "function" then
        pcall(firetouchinterest, handle, hrp, 0)
        pcall(firetouchinterest, handle, hrp, 1)
    end
    local touched = tool:FindFirstChild("HandleTouched", true)
    local stabbed = tool:FindFirstChild("KnifeStabbed", true)
    if touched and touched:IsA("RemoteEvent") and hrp then pcall(touched.FireServer, touched, hrp) end
    if stabbed and stabbed:IsA("RemoteEvent") then pcall(stabbed.FireServer, stabbed) end
    return true
end

