local Farm = {
    on = false, speed = Store.Get("sliders", "Farm::speed", 24),
    grab = false, aura = false, autoReset = false, avoid = false,
    targets = {}, done = false, noclip = {},
}

local function farmRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function canFarm()
    local h = localHum()
    if not h or h.Health <= 0 then return false end
    local c = LP.Character
    return c ~= nil
end

local function bagsFull()
    local pg = LP:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("MainGUI")
    local gg = main and main:FindFirstChild("Game")
    local bags = gg and gg:FindFirstChild("CoinBags")
    local cont = bags and bags:FindFirstChild("Container")
    if not cont then return false end
    local any = false
    for _, v in ipairs(cont:GetChildren()) do
        if v:IsA("Frame") and v.Visible then
            any = true
            local f = v:FindFirstChild("Full")
            if not (f and f.Visible) then return false end
        end
    end
    return any
end

local function setNoclip(on)
    local c = LP.Character
    if not c then return end
    if on then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                Farm.noclip[p] = true
                p.CanCollide = false
            end
        end
    else
        for p in pairs(Farm.noclip) do
            if p and p.Parent then p.CanCollide = true end
        end
        table.clear(Farm.noclip)
    end
end

local function touchCoin(coin)
    local root = farmRoot()
    if not root or not coin or type(firetouchinterest) ~= "function" then return end
    pcall(firetouchinterest, root, coin, 0)
    pcall(firetouchinterest, root, coin, 1)
end

RunService.Stepped:Connect(function(_, dt)
    if not Farm.on then return end
    if not canFarm() then setNoclip(false); return end

    local root = farmRoot()
    if not root then return end

    local coins = {}
    for _, c in ipairs(CollectionService:GetTagged("CoinVisual")) do
        if c and c.Parent and c:IsA("BasePart") and not c:GetAttribute("Collected") and not c:GetAttribute("Delete") then
            coins[#coins + 1] = c
        end
    end

    if bagsFull() then
        Farm.on = false
        setNoclip(false)
        Notify("Bolsa llena · farm detenido", 2)
        if Farm.autoReset then
            local h = localHum(); if h then h.Health = 0 end
        end
        return
    end

    if #coins == 0 then setNoclip(false); return end

    local best, bd
    for _, c in ipairs(coins) do
        local d = (c.Position - root.Position).Magnitude
        if not bd or d < bd then best, bd = c, d end
    end
    if not best then return end

    setNoclip(true)
    if bd <= 6 then touchCoin(best) end

    local dest = best.Position
    local dir = dest - root.Position
    local dist = dir.Magnitude
    local nextPos = dist > 0.2 and (root.Position + dir.Unit * math.min(Farm.speed * dt, dist)) or dest
    pcall(function()
        root.CFrame = CFrame.new(nextPos)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
end)

