local function mk(class, props, parent)
    local o = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            if k == "Text" or k == "PlaceholderText" then
                o[k] = L(v)
            else
                o[k] = v
            end
        end
    end
    o.Parent = parent
    return o
end
local function corner(o, r)
    mk("UICorner", { CornerRadius = UDim.new(0, r or 10) }, o)
    return o
end
local function border(o, col, tr, th)
    local s = mk("UIStroke", {
        Color = col or T.line, Transparency = tr or 0.5,
        Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, o)
    return s
end
local function pad(o, n)
    mk("UIPadding", {
        PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n),
        PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n),
    }, o)
    return o
end

--============================== FX ==================================
-- Un solo driver de render para muelles y gradientes animados.
local FX = { springs = {}, spins = {}, active = false }
local function spring(initial, stiffness, damping, apply)
    local s = { p = initial, v = 0, t = initial, k = stiffness, d = math.min(damping, 1), apply = apply }
    function s:Set(v) self.t = v; FX.springs[self] = true; FX.active = true end
    function s:Snap(v) self.p = v; self.t = v; self.v = 0; FX.springs[self] = nil; apply(v) end
    apply(initial)
    return s
end
local function spin(gradient)
    FX.spins[gradient] = true; FX.active = true
    return gradient
end

local SPIN_RING = ColorSequence.new({
    ColorSequenceKeypoint.new(0.00, Color3.fromRGB(70, 62, 130)),
    ColorSequenceKeypoint.new(0.30, Color3.fromRGB(196, 186, 255)),
    ColorSequenceKeypoint.new(0.55, Color3.fromRGB(139, 122, 255)),
    ColorSequenceKeypoint.new(0.80, Color3.fromRGB(255, 255, 255)),
    ColorSequenceKeypoint.new(1.00, Color3.fromRGB(70, 62, 130)),
})

RunService.RenderStepped:Connect(function(dt)
    if not FX.active then return end
    dt = math.min(dt, 1 / 20)

    for g in pairs(FX.spins) do
        if g.Parent then g.Rotation = (g.Rotation + 55 * dt) % 360 else FX.spins[g] = nil end
    end

    local any = false
    for s in pairs(FX.springs) do
        any = true
        local x0, v0 = s.p - s.t, s.v
        local x, v
        if s.d >= 1 then
            local e = math.exp(-s.k * dt)
            x = (x0 + (v0 + s.k * x0) * dt) * e
            v = (v0 - (v0 + s.k * x0) * s.k * dt) * e
        else
            local c = math.sqrt(1 - s.d * s.d)
            local e = math.exp(-s.d * s.k * dt)
            local co, si = math.cos(c * s.k * dt), math.sin(c * s.k * dt)
            x = (x0 * (co + s.d / c * si) + v0 * si / (c * s.k)) * e
            v = (v0 * (co - s.d / c * si) - x0 * s.k / c * si) * e
        end
        s.p, s.v = x + s.t, v
        if math.abs(x) < 0.001 and math.abs(v) < 0.001 then
            s.p, s.v = s.t, 0
            FX.springs[s] = nil
        end
        s.apply(s.p)
    end
    if not any and next(FX.spins) == nil then FX.active = false end
end)

