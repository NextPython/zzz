    mk("TextLabel", { Parent = card, Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -28, 0, 38),
        BackgroundTransparency = 1, Text = tostring(text), TextColor3 = T.text, TextSize = 13,
        Font = Enum.Font.GothamMedium, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 5002 }, nil)

    table.insert(notifLive, card)
    while #notifLive > 3 do
        local old = table.remove(notifLive, 1)
        if old then old:Destroy() end
    end

    task.delay(life, function()
        for i = #notifLive, 1, -1 do
            if notifLive[i] == card then table.remove(notifLive, i) break end
        end
        if card.Parent then
            local tw = TweenService:Create(card, TweenInfo.new(0.2), {
                BackgroundTransparency = 1, Position = UDim2.fromOffset(30, 0),
            })
            tw:Play(); tw.Completed:Connect(function() card:Destroy() end)
        end
    end)
end
